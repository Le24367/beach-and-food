            <div class="pm-header">
              <div class="pm-logo">B&F</div>
              <div class="pm-title">Beach and Food</div>
            </div>
            <div class="pm-items">
              <div class="pm-item">
                <span class="pm-emoji">🐟</span>
                <div class="pm-item-info">
                  <span class="pm-name">Fischbrötchen</span>
                  <span class="pm-sub">Klassiker</span>
                </div>
                <button class="pm-add">+</button>
              </div>
              <div class="pm-item">
                <span class="pm-emoji">🍟</span>
                <div class="pm-item-info">
                  <span class="pm-name">Pommes frites</span>
                  <span class="pm-sub">167°C</span>
                </div>
                <button class="pm-add">+</button>
              </div>
              <div class="pm-item">
                <span class="pm-emoji">🌭</span>
                <div class="pm-item-info">
                  <span class="pm-name">Currywurst</span>
                  <span class="pm-sub">Hausgemacht</span>
