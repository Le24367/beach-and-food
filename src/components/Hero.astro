---
import { getLinks } from '../lib/sanity'
import busWebp from '../assets/bus/bus-body-nowheels.webp'
import busPng from '../assets/bus/bus-body-nowheels.png'
import wheelFrontWebp from '../assets/bus/wheel-front.webp'
import wheelBackWebp from '../assets/bus/wheel-back.webp'
const links = await getLinks()
---
<section class="hero" id="hero">
  <!-- Ohne JS gibt es keine Bus-Sequenz, die .hero-inner/.hero-scroll sichtbar
       machen könnte — harter CSS-Fallback, damit der Inhalt nicht für immer
       ausgeblendet bleibt. -->
  <noscript>
    <style>
      .bus-wrap, .beach-strip { display: none; }
      .hero-inner, .hero-scroll { opacity: 1 !important; pointer-events: auto !important; }
    </style>
  </noscript>
  <div class="hero-bg">
    <div class="sun-orb"></div>
  </div>
  <div class="waves-container">
    <svg class="waves" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none">
      <defs>
        <path id="wave-path" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352z"/>
      </defs>
      <g class="wave-parallax">
        <use href="#wave-path" class="wave-layer wave-layer1" x="48" y="0"/>
        <use href="#wave-path" class="wave-layer wave-layer2" x="48" y="3"/>
        <use href="#wave-path" class="wave-layer wave-layer3" x="48" y="5"/>
        <use href="#wave-path" class="wave-layer wave-layer4" x="48" y="7"/>
      </g>
    </svg>
  </div>

  <div class="beach-strip" aria-hidden="true"></div>

  <!--
    Bus-Anfahrt: ersetzt die frühere sofortige LCP-Sichtbarkeit des Titels
    bewusst durch eine Show-Sequenz (Absprache mit Kunde). Physik der
    Radrotation ist exakt an die tatsächlich zurückgelegte Strecke gekoppelt
    (siehe trackWheelRotation im Script unten), WHEEL_TIRE_FILL_RATIO
    kompensiert den transparenten Rand um den Reifen in den PNG/WEBP-Assets.
  -->
  <div class="bus-wrap" id="busWrap">
    <picture>
      <source srcset={busWebp.src} type="image/webp" />
      <img
        src={busPng.src}
        alt=""
        aria-hidden="true"
        class="bus-body"
        width={busPng.width}
        height={busPng.height}
        fetchpriority="high"
        decoding="async"
      />
    </picture>

    <div class="wheel-well well-front"></div>
    <div class="wheel-well well-back"></div>

    <div class="wheel wheel-front" id="wheelFront">
      <picture>
        <source srcset={wheelFrontWebp.src} type="image/webp" />
        <img src={wheelFrontWebp.src} alt="" aria-hidden="true" loading="eager" />
      </picture>
    </div>

    <div class="wheel wheel-back" id="wheelBack">
      <picture>
        <source srcset={wheelBackWebp.src} type="image/webp" />
        <img src={wheelBackWebp.src} alt="" aria-hidden="true" loading="eager" />
      </picture>
    </div>
  </div>

  <div class="container hero-inner" id="heroInner">
    <div class="hero-badge">
      <span class="badge-dot" aria-hidden="true"></span>
      <span>Foodtruck 2.0 · Sütel-Strand</span>
    </div>

    <!--
      Frühere LCP-Sofort-Sichtbarkeit (h1 ohne Animation) wurde bewusst
      aufgegeben: der Titel erscheint jetzt wie der Rest von .hero-inner
      erst nach der Bus-Zoom-Sequenz (siehe .hero-inner.visible weiter
      oben und das Script am Ende der Datei). Abgestimmter Trade-off,
      kein Versehen — LCP wird dadurch um die Animationsdauer verzögert.
    -->
    <h1 class="hero-title">
      Bei exakt<br/>
      <span class="temp">167°C</span><br/>
      immer frisch.
    </h1>

    <p class="hero-sub">Alles andere ist Wissenschaft.</p>
    <p class="hero-desc">
      Fischbrötchen, Currywurst, Pommes und kalte Drinks —<br class="br-lg"/>
      direkt am Sütel-Strand auf dem Campingplatz Sütel.
    </p>
    <div class="hero-actions">
      <a href={links.order} target="_blank" rel="noopener" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        Jetzt online bestellen
      </a>
      <a href="#angebot" class="btn-secondary">Speisekarte ansehen</a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-num">167°C</span>
        <span class="stat-label">Frittiertemperatur</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat-num">Indoor</span>
        <span class="stat-label">Sitzbereich</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat">
        <span class="stat-num">Digital</span>
        <span class="stat-label">Bestellung</span>
      </div>
    </div>
  </div>

  <div class="hero-scroll" id="heroScroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  background: var(--ocean-deep);
  padding: 8rem 0 12rem;
}
@media (max-height: 600px) and (orientation: landscape) {
  .hero { min-height: 130vh; padding-bottom: 14rem; }
}
.hero-bg { position: absolute; inset: 0; pointer-events: none; }
.sun-orb {
  position: absolute;
  top: -120px; right: -80px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(244,168,32,0.35) 0%, rgba(255,149,0,0.15) 40%, transparent 70%);
  border-radius: 50%;
}
.waves-container {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 160px;
  overflow: hidden;
}
.waves { position: absolute; bottom: 0; width: 200%; height: 100%; }
.wave-parallax > use { animation: wave-move 20s cubic-bezier(.55,.5,.45,.5) infinite; }
.wave-layer1 { fill: rgba(251,244,230,0.7); animation-duration: 12s; animation-delay: -2s; }
.wave-layer2 { fill: rgba(251,244,230,0.5); animation-duration: 16s; animation-delay: -4s; }
.wave-layer3 { fill: rgba(251,244,230,0.3); animation-duration: 20s; animation-delay: -6s; }
.wave-layer4 { fill: rgba(251,244,230,1);   animation-duration: 24s; animation-delay: -8s; }
@keyframes wave-move {
  0%   { transform: translate3d(-90px, 0, 0); }
  100% { transform: translate3d(85px,  0, 0); }
}
/* ── Beach-Fahrbahn + Bus-Anfahrt ────────────────────────────────── */
.beach-strip {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 230px;
  background: linear-gradient(to bottom, transparent 0%, var(--sand-light) 40%, var(--sand-light) 100%);
  z-index: 1;
}

.bus-wrap {
  position: absolute;
  left: -60%;
  bottom: 165px;
  width: 46%;
  max-width: 620px;
  z-index: 3;
  transform-origin: 41% 50%;
  will-change: left, transform, opacity;
}
.bus-body { width: 100%; height: auto; display: block; }

.wheel-well {
  position: absolute;
  width: 10.8%;
  height: 22.5%;
  top: 57.5%;
  background: #2b2b29;
  border-radius: 50% 50% 3px 3px;
}
.well-front { left: 23.15%; }
.well-back  { left: 66.75%; }

.wheel {
  position: absolute;
  width: 10.5%;
  top: 58%;
}
.wheel img { width: 100%; height: auto; display: block; }
.wheel-front { left: 23.45%; }
.wheel-back  { left: 67.05%; }

.bus-wrap.arrived {
  left: 15%;
  transition: left 3.2s cubic-bezier(.25,.7,.3,1);
}
.bus-wrap.zoom {
  transform: scale(9);
  opacity: 0;
  transition: transform 1.1s ease-in, opacity 1.1s ease-in;
}

/* Fallback ohne Animation (reduced-motion / langsame Verbindung):
   Bus komplett weglassen, Inhalt wird per JS sofort sichtbar gemacht. */
.no-anim .bus-wrap,
.no-anim .beach-strip {
  display: none;
}

.hero-inner {
  position: relative;
  z-index: 4;
  color: var(--foam);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.6s ease-in;
}
.hero-inner.visible { opacity: 1; pointer-events: auto; }

/*
  Titel/Badge/CTAs etc. sind absichtlich erst nach der Bus-Zoom-Sequenz
  sichtbar (siehe Script unten) — bewusster Trade-off gegen die frühere
  LCP-Sofort-Sichtbarkeit, mit dem Kunden abgestimmt. Jedes Element bleibt
  bis dahin opacity:0 (statisch, nicht Teil der Animation) und startet sein
  fadeDown erst, sobald .hero-inner die Klasse .visible bekommt.
*/
.hero-title,
.hero-badge,
.hero-sub,
.hero-desc,
.hero-actions,
.hero-stats {
  opacity: 0;
}
.hero-inner.visible .hero-title   { animation: fadeDown 0.8s ease both; }
.hero-inner.visible .hero-badge   { animation: fadeDown 0.8s 0.1s ease both; }
.hero-inner.visible .hero-sub     { animation: fadeDown 0.8s 0.2s ease both; }
.hero-inner.visible .hero-desc    { animation: fadeDown 0.8s 0.3s ease both; }
.hero-inner.visible .hero-actions { animation: fadeDown 0.8s 0.4s ease both; }
.hero-inner.visible .hero-stats   { animation: fadeDown 0.8s 0.5s ease both; }

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(8px);
  padding: 0.4rem 1rem;
  border-radius: 100px;
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 2rem;
  /*
    KONTRAST-FIX: Explizit #ffffff setzen.
    #ffffff auf #0D2233 (ocean-deep) → 16.1:1 (WCAG AAA ✓).
    font-weight auf 600 erhöht (war 500) — verbessert Lesbarkeit zusätzlich.
  */
  color: #ffffff;
}
.badge-dot {
  width: 8px; height: 8px;
  background: var(--coral);
  border-radius: 50%;
  animation: pulse 2s ease infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.8); }
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3rem, 8vw, 6.5rem);
  font-weight: 900;
  line-height: 1.0;
  letter-spacing: -0.02em;
  margin-bottom: 1rem;
}
.temp {
  color: var(--sun);
  font-style: italic;
  display: inline-block;
  animation: glow 3s ease infinite alternate;
}
@keyframes glow {
  from { text-shadow: 0 0 20px rgba(244,168,32,0.3); }
  to   { text-shadow: 0 0 60px rgba(244,168,32,0.7); }
}
.hero-sub {
  font-size: 1.1rem;
  color: var(--coral);
  font-style: italic;
  margin-bottom: 1.5rem;
}
.hero-desc {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.75);
  line-height: 1.6;
  margin-bottom: 2.5rem;
}
.br-lg { display: none; }
@media (min-width: 600px) { .br-lg { display: inline; } }
.hero-actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 3.5rem;
}
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--sun);
  color: var(--ocean-deep);
  font-weight: 700;
  font-size: 1rem;
  padding: 0.85rem 1.8rem;
  border-radius: 100px;
  transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  box-shadow: 0 4px 20px rgba(244,168,32,0.4);
}
.btn-primary:hover {
  background: var(--sun-bright);
  transform: translateY(-2px);
  box-shadow: 0 8px 30px rgba(244,168,32,0.5);
}
.btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(255,255,255,0.1);
  color: var(--foam);
  font-weight: 600;
  font-size: 1rem;
  padding: 0.85rem 1.8rem;
  border-radius: 100px;
  border: 1px solid rgba(255,255,255,0.2);
  transition: background 0.2s, transform 0.15s;
}
.btn-secondary:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }
.hero-stats {
  display: flex;
  align-items: center;
  gap: 2rem;
  flex-wrap: wrap;
}
.stat { display: flex; flex-direction: column; gap: 0.2rem; }
.stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--sun);
}
.stat-label {
  font-size: 0.75rem;
  color: rgba(255,255,255,0.65);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.15); }
.hero-scroll {
  position: absolute;
  bottom: 220px; right: 2rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  /*
    KONTRAST-FIX: rgba(255,255,255,0.35) auf #0D2233 → ~2.1:1 (WCAG-Fehler).
    Neu: rgba(255,255,255,0.70) auf #0D2233 → ~6.0:1 (WCAG AA ✓).
    Das Element hat aria-hidden="true", Lighthouse prüft es dennoch —
    daher den Kontrast auf einen sicheren Wert anheben.
  */
  color: rgba(255,255,255,0.70);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  writing-mode: vertical-lr;
  z-index: 4;
  opacity: 0;
}
.hero-scroll.visible { animation: fadeDown 1s 0.5s ease both; }
.scroll-line {
  width: 1px; height: 60px;
  background: linear-gradient(to bottom, rgba(255,255,255,0.70), transparent);
  animation: scrollLine 2s ease infinite;
}
@keyframes scrollLine {
  0%  { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform: scaleY(1); transform-origin: bottom; }
  100%{ transform: scaleY(0); transform-origin: bottom; }
}
@keyframes fadeDown {
  from { opacity: 0; transform: translateY(-20px); }
  to   { opacity: 1; transform: none; }
}
@media (max-width: 768px) {
  .hero-scroll { display: none; }
  .hero-stats { gap: 1.5rem; }
}
</style>

<script>
  // Bus-Anfahrt-Sequenz: fährt ein, Räder drehen sich physikalisch exakt zur
  // zurückgelegten Strecke (kein IntersectionObserver nötig — der Hero ist
  // immer im initialen Viewport), zoomt zur Tür, gibt dann den eigentlichen
  // Hero-Inhalt frei (siehe .hero-inner.visible in den Styles oben).
  const heroSection = document.getElementById('hero');
  const busWrap = document.getElementById('busWrap');
  const wheelFront = document.getElementById('wheelFront');
  const wheelBack = document.getElementById('wheelBack');
  const wheelFrontImg = wheelFront?.querySelector('img') as HTMLElement | null;
  const wheelBackImg = wheelBack?.querySelector('img') as HTMLElement | null;
  const heroInner = document.getElementById('heroInner');
  const heroScroll = document.getElementById('heroScroll');

  let rafId: number | null = null;
  let totalRotation = 0;

  // Die Wheel-Assets (240x240) haben einen transparenten Rand um den Reifen;
  // der sichtbare Reifen füllt nur ~92% der Bildbreite. Ohne diese Korrektur
  // würde der berechnete Radumfang zu groß ausfallen und das Rad beim
  // Abrollen sichtbar rutschen statt physikalisch korrekt zu drehen.
  const WHEEL_TIRE_FILL_RATIO = 0.9208;

  function revealContent() {
    heroInner?.classList.add('visible');
    heroScroll?.classList.add('visible');
  }

  function trackWheelRotation(onDone: () => void) {
    if (!busWrap || !wheelFrontImg || !wheelBackImg) return;
    const wheelRadiusPx = (wheelFrontImg.getBoundingClientRect().width * WHEEL_TIRE_FILL_RATIO) / 2;
    const circumference = 2 * Math.PI * wheelRadiusPx;
    const degPerPx = 360 / circumference;

    let lastX = busWrap.getBoundingClientRect().left;
    let hasMoved = false;
    let stillFrames = 0;

    function tick() {
      const currentX = busWrap!.getBoundingClientRect().left;
      const deltaX = currentX - lastX;
      lastX = currentX;

      if (Math.abs(deltaX) > 0.02) {
        hasMoved = true;
        stillFrames = 0;
        totalRotation += deltaX * degPerPx;
        const t = `rotate(${totalRotation}deg)`;
        wheelFrontImg!.style.transform = t;
        wheelBackImg!.style.transform = t;
      } else if (hasMoved) {
        stillFrames++;
      }

      if (hasMoved && stillFrames > 4) {
        onDone();
        return;
      }
      rafId = requestAnimationFrame(tick);
    }
    rafId = requestAnimationFrame(tick);
  }

  function runSequence() {
    const conn = (navigator as any).connection;
    const slow = conn && (conn.effectiveType === 'slow-2g' || conn.effectiveType === '2g');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (slow || reduceMotion) {
      heroSection?.classList.add('no-anim');
      revealContent();
      return;
    }

    if (!busWrap || !wheelFrontImg || !wheelBackImg) {
      revealContent();
      return;
    }

    trackWheelRotation(() => {
      setTimeout(() => busWrap?.classList.add('zoom'), 800);
      setTimeout(() => revealContent(), 1800);
    });

    requestAnimationFrame(() => {
      setTimeout(() => busWrap?.classList.add('arrived'), 50);
    });
  }

  runSequence();
</script>