---
import { getLinks } from '../lib/sanity'
const links = await getLinks()
---
<nav class="navbar" id="navbar">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <!--
        Logo auf dunklem transparenten Hintergrund:
        weißer Hintergrund-Pill damit das Logo auf Navy sichtbar bleibt.
        Beim Scrollen (Glassmorphism) bleibt der Pill erhalten → konsistente Lesbarkeit.
      -->
      <div class="logo-pill">
        <picture>
          <source
            type="image/webp"
            srcset="/logo/logo-300w.webp 300w, /logo/logo-600w.webp 600w"
            sizes="(max-width: 1024px) 300px, 300px"
          />
          <img
            src="/logo/logo.jpeg"
            alt="Beach and Food"
            class="logo-img"
            width="300"
            height="77"
            fetchpriority="high"
          />
        </picture>
      </div>
    </a>

    <ul class="nav-links">
      <li><a href="#angebot" class="nav-link">Speisekarte</a></li>
      <li><a href="#vibes" class="nav-link">Beach Vibes</a></li>
      <li><a href="#ueber-uns" class="nav-link">Über uns</a></li>
      <li><a href="#kontakt" class="nav-link">Kontakt</a></li>
      <li><a href={links.voucher} target="_blank" rel="noopener" class="nav-link">🎁 Gutschein</a></li>
    </ul>

    <a href={links.order} target="_blank" rel="noopener" class="nav-cta">Jetzt bestellen</a>

    <button class="burger" id="burger" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <ul>
      <li><a href="#angebot">Speisekarte</a></li>
      <li><a href="#vibes">Beach Vibes</a></li>
      <li><a href="#ueber-uns">Über uns</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
      <li><a href={links.voucher} target="_blank" rel="noopener">🎁 Gutschein</a></li>
      <li><a href={links.order} target="_blank" rel="noopener" class="nav-cta-mobile">Jetzt bestellen</a></li>
    </ul>
  </div>
</nav>

<style>
/* ─── Basis ─────────────────────────────────────────────────────────── */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  /* Standard: komplett transparent über dem dunklen Hero */
  background: transparent;
  border-bottom: 1px solid transparent;
  transition: background 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              border-color 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              backdrop-filter 0.4s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Glassmorphism-Zustand nach >50px Scroll */
.navbar.scrolled {
  background: rgba(13, 27, 42, 0.88);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(253, 175, 63, 0.18);
  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
  border-radius: 0 0 16px 16px;
}

/* ─── Nav Inner ─────────────────────────────────────────────────────── */
.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-top: 1rem;
  padding-bottom: 1rem;
}

/* ─── Logo ──────────────────────────────────────────────────────────── */
.logo { display: flex; align-items: center; flex-shrink: 0; }

/*
  Logo-Pill: weißer Hintergrund damit das Logo auf dem transparenten/
  dunklen Navbar-Hintergrund immer gut lesbar ist.
  Padding klein halten → Pill ist dezent, nicht aufdringlich.
*/
.logo-pill {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 10px;
  padding: 4px 12px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  transition: box-shadow 0.3s ease;
}
.logo-pill:hover {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.22);
}
.logo-img {
  height: 36px;
  width: auto;
  object-fit: contain;
  display: block;
}

/* ─── Nav Links ─────────────────────────────────────────────────────── */
.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
  margin-left: auto;
}

.nav-link {
  font-size: 0.9rem;
  font-weight: 500;
  color: #ffffff;
  position: relative;
  padding-bottom: 3px;
  transition: color 0.25s ease;
}

/* Amber-Unterlinie — animiert beim Hover */
.nav-link::after {
  content: '';
  display: block;
  height: 2px;
  background: #FDAF3F; /* Brand Amber */
  border-radius: 2px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
  position: absolute;
  bottom: -2px;
  left: 0; right: 0;
}
.nav-link:hover::after,
.nav-link.active::after {
  transform: scaleX(1);
}
.nav-link:hover { color: #FDAF3F; }
.nav-link.active { color: #FDAF3F; font-weight: 600; }

/* ─── CTA-Button ────────────────────────────────────────────────────── */
.nav-cta {
  background: #C11B2C; /* Brand Rot */
  color: #ffffff;
  font-weight: 600;
  font-size: 0.85rem;
  padding: 0.55rem 1.2rem;
  border-radius: 6px;
  white-space: nowrap;
  transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}
/* Shimmer-Effekt auf dem CTA */
.nav-cta::after {
  content: '';
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.18), transparent);
  transform: skewX(-20deg);
  transition: left 0.5s ease;
}
.nav-cta:hover {
  background: #A01525;
  transform: scale(1.02);
  box-shadow: 0 4px 16px rgba(193, 27, 44, 0.35);
}
.nav-cta:hover::after { left: 150%; }

/* ─── Burger ────────────────────────────────────────────────────────── */
.burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  margin-left: auto;
  padding: 6px;
  border-radius: 6px;
  transition: background 0.2s;
}
.burger:hover { background: rgba(255, 255, 255, 0.1); }
.burger span {
  display: block;
  width: 24px;
  height: 2px;
  background: #ffffff;
  border-radius: 2px;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.25s ease;
}
.burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ─── Mobile Menu ───────────────────────────────────────────────────── */
.mobile-menu {
  max-height: 0;
  overflow: hidden;
  /* Dunkel + Glassmorphism — konsistent mit Navbar.scrolled */
  background: rgba(13, 27, 42, 0.97);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.35s ease;
  opacity: 0;
}
.mobile-menu.open {
  max-height: 500px;
  opacity: 1;
  border-radius: 0 0 16px 16px;
  border-top: 1px solid rgba(253, 175, 63, 0.12);
}
.mobile-menu ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  padding: 0.5rem 1.5rem 1.5rem;
}
.mobile-menu li {
  border-bottom: 1px solid rgba(253, 175, 63, 0.12); /* Amber-Trenner */
  transform: translateY(-8px);
  opacity: 0;
  transition: transform 0.35s ease, opacity 0.35s ease;
}
.mobile-menu li:last-child { border-bottom: none; }

/* Staggered entry beim Öffnen */
.mobile-menu.open li:nth-child(1) { transition-delay: 0.05s; }
.mobile-menu.open li:nth-child(2) { transition-delay: 0.10s; }
.mobile-menu.open li:nth-child(3) { transition-delay: 0.15s; }
.mobile-menu.open li:nth-child(4) { transition-delay: 0.20s; }
.mobile-menu.open li:nth-child(5) { transition-delay: 0.25s; }
.mobile-menu.open li:nth-child(6) { transition-delay: 0.30s; }
.mobile-menu:not(.open) li { transition-delay: 0s !important; }
.mobile-menu.open li { transform: translateY(0); opacity: 1; }

.mobile-menu a {
  display: block;
  font-size: 1.05rem;
  font-weight: 500;
  color: rgba(245, 240, 232, 0.85);
  padding: 0.9rem 0;
  transition: color 0.2s, padding-left 0.2s;
}
.mobile-menu a:hover {
  color: #FDAF3F;
  padding-left: 0.5rem;
}
.nav-cta-mobile {
  display: block;
  text-align: center;
  background: #C11B2C !important;
  color: #ffffff !important;
  font-weight: 700;
  padding: 0.75rem 1.4rem !important;
  border-radius: 6px;
  margin-top: 0.75rem;
  margin-bottom: 0.25rem;
  transition: background 0.2s ease;
}
.nav-cta-mobile:hover {
  background: #A01525 !important;
  padding-left: 0 !important; /* kein indent bei CTA */
}

/* ─── Responsive ────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .nav-links, .nav-cta { display: none; }
  .burger { display: flex; }
}

/* ─── Reduced Motion ────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .navbar,
  .nav-link::after,
  .nav-cta,
  .burger span,
  .mobile-menu,
  .mobile-menu li,
  .mobile-menu a {
    transition: none !important;
  }
}
</style>

<script>
  // ── Glassmorphism on Scroll ────────────────────────────────────────
  const navbar = document.getElementById('navbar')
  if (navbar) {
    const handleScroll = () => {
      navbar.classList.toggle('scrolled', window.scrollY > 50)
    }
    // Sofort beim Laden prüfen (bei Page-Reload weiter unten)
    handleScroll()
    window.addEventListener('scroll', handleScroll, { passive: true })
  }

  // ── Hamburger Toggle ───────────────────────────────────────────────
  const burger = document.getElementById('burger')
  const mobileMenu = document.getElementById('mobile-menu')

  burger?.addEventListener('click', () => {
    const isOpen = burger.classList.toggle('open')
    mobileMenu?.classList.toggle('open', isOpen)
    burger.setAttribute('aria-expanded', String(isOpen))
    burger.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen')
  })

  // Menü schließen beim Klick auf Link
  mobileMenu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      mobileMenu.classList.remove('open')
      burger?.classList.remove('open')
      burger?.setAttribute('aria-expanded', 'false')
      burger?.setAttribute('aria-label', 'Menü öffnen')
    })
  })

  // Menü schließen bei resize > Breakpoint
  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024) {
      mobileMenu?.classList.remove('open')
      burger?.classList.remove('open')
      burger?.setAttribute('aria-expanded', 'false')
    }
  })

  // ── Active-State via IntersectionObserver ──────────────────────────
  const sections = ['angebot', 'vibes', 'ueber-uns', 'kontakt']
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-links .nav-link[href^="#"]')

  const setActive = (id: string) => {
    navLinks.forEach(a => {
      a.classList.toggle('active', a.getAttribute('href') === `#${id}`)
    })
  }

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) setActive(entry.target.id)
    })
  }, {
    rootMargin: '-40% 0px -55% 0px',
    threshold: 0,
  })

  sections.forEach(id => {
    const el = document.getElementById(id)
    if (el) sectionObserver.observe(el)
  })
</script>