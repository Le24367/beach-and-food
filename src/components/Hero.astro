---
import { getLinks } from '../lib/sanity'
const links = await getLinks()
---
<section class="hero" id="hero">

  <div class="hero-bg" aria-hidden="true">
    <div class="bg-orb bg-orb--amber"></div>
    <div class="bg-orb bg-orb--blue"></div>
    <div class="bg-noise"></div>
  </div>

  <div class="waves-container" aria-hidden="true">
    <svg class="waves" xmlns="http://www.w3.org/2000/svg" viewBox="0 24 150 28" preserveAspectRatio="none">
      <defs>
        <path id="hero-wave-path" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352z"/>
      </defs>
      <g class="wave-parallax">
        <use href="#hero-wave-path" class="wave-layer wave-layer1" x="48" y="0"/>
        <use href="#hero-wave-path" class="wave-layer wave-layer2" x="48" y="3"/>
        <use href="#hero-wave-path" class="wave-layer wave-layer3" x="48" y="5"/>
        <use href="#hero-wave-path" class="wave-layer wave-layer4" x="48" y="7"/>
      </g>
    </svg>
  </div>

  <div class="container hero-inner">

    <div class="hero-label">
      <span class="label-dot" aria-hidden="true"></span>
      Foodtruck 2.0 · Sütel-Strand
    </div>

    <!--
      H1: KEINE Animation — LCP-Schutz.
      aria-label bleibt statisch für Screen Reader.
      JS-Counter überschreibt nur den visuell sichtbaren Inhalt.
    -->
    <h1 class="hero-title">
      Bei exakt
      <span class="temp" id="temp-display" aria-label="167 Grad Celsius">
        <span id="temp-number" aria-hidden="true">167</span>°C
      </span><br/>
      immer frisch.
    </h1>

    <p class="hero-sub">Alles andere ist Wissenschaft.</p>

    <p class="hero-desc">
      Fischbrötchen, Currywurst, Pommes und kalte Drinks —<br class="br-lg"/>
      direkt am Sütel-Strand auf dem Campingplatz Sütel.
    </p>

    <div class="hero-ctas">
      <a href={links.order} target="_blank" rel="noopener" class="btn-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        Jetzt online bestellen
      </a>
      <a href="#angebot" class="btn-secondary">Speisekarte ansehen</a>
    </div>

    <div class="hero-badges">
      <span class="hero-badge-pill">
        <span class="bp-dot" aria-hidden="true"></span>
        167°C Frittiertemperatur
      </span>
      <span class="hero-badge-pill">
        <span class="bp-dot" aria-hidden="true"></span>
        Indoor Sitzbereich
      </span>
      <span class="hero-badge-pill">
        <span class="bp-dot" aria-hidden="true"></span>
        Digital Bestellung
      </span>
    </div>

  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="scroll-text">Scroll</span>
    <div class="scroll-line"></div>
  </div>

</section>

<style>
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  background: #0D1B2A;
  padding: 8rem 0 13rem;
}
@media (max-height: 600px) and (orientation: landscape) {
  .hero { min-height: 130vh; padding-bottom: 14rem; }
}

/* ── Hintergrund ── */
.hero-bg { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
.bg-orb  { position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none; }
.bg-orb--amber {
  top: -150px; right: -100px; width: 580px; height: 580px;
  background: radial-gradient(circle, rgba(253,175,63,0.22) 0%, rgba(235,179,93,0.10) 40%, transparent 70%);
}
.bg-orb--blue {
  bottom: 80px; left: -150px; width: 500px; height: 500px;
  background: radial-gradient(circle, rgba(51,61,145,0.20) 0%, transparent 70%);
}
.bg-noise {
  position: absolute; inset: 0; opacity: 0.025; pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
}

/* ── Wellen ── */
.waves-container { position: absolute; bottom: 0; left: 0; right: 0; height: 160px; overflow: hidden; }
.waves { position: absolute; bottom: 0; width: 200%; height: 100%; }
.wave-parallax > use { animation: wave-move 20s cubic-bezier(.55,.5,.45,.5) infinite; }
.wave-layer1 { fill: rgba(251,244,230,0.7); animation-duration: 12s; animation-delay: -2s; }
.wave-layer2 { fill: rgba(251,244,230,0.5); animation-duration: 16s; animation-delay: -4s; }
.wave-layer3 { fill: rgba(251,244,230,0.3); animation-duration: 20s; animation-delay: -6s; }
.wave-layer4 { fill: rgba(251,244,230,1);   animation-duration: 24s; animation-delay: -8s; }
@keyframes wave-move {
  0%   { transform: translate3d(-90px, 0, 0); }
  100% { transform: translate3d(85px, 0, 0); }
}

/* ── Layout ── */
.hero-inner {
  position: relative; z-index: 2; color: #F5F0E8;
}

/* ── Label ── */
.hero-label {
  display: inline-flex; align-items: center; gap: 0.5rem;
  color: #FDAF3F; font-size: 13px; font-weight: 600;
  letter-spacing: 0.15em; text-transform: uppercase;
  border: 1px solid rgba(253,175,63,0.3); border-radius: 20px;
  padding: 6px 16px; margin-bottom: 2rem;
  opacity: 0; animation: fadeUp 0.6s ease forwards 0.1s;
}
.label-dot {
  width: 7px; height: 7px; background: #FDAF3F; border-radius: 50%;
  animation: pulse-dot 2s ease infinite;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%       { opacity: 0.5; transform: scale(0.75); }
}

/* ── H1 — kein animation, LCP-Schutz ── */
.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3rem, 8vw, 6.5rem);
  font-weight: 900; line-height: 1.0;
  letter-spacing: -0.02em; color: #F5F0E8;
  margin-bottom: 1.25rem;
}

/* ── 167°C — Signature Element ── */
.temp {
  color: #FDAF3F;
  font-style: italic;
  display: inline-block;
  white-space: nowrap;
  /*
    Glow startet erst nach dem Count-Up (JS fügt .glow-active hinzu).
    So leuchtet die Zahl erst wenn sie bei 167 angekommen ist.
  */
}
.temp.glow-active {
  animation: glow-pulse 3s ease infinite alternate;
}
/*
  Flash wenn Counter landet — kurzer weißer Aufblitz, dann Glow.
  JS setzt .flash-active für 600ms, entfernt es dann.
*/
.temp.flash-active {
  animation: temp-flash 0.55s ease forwards;
}
@keyframes temp-flash {
  0%   { color: #FDAF3F; text-shadow: none; }
  35%  { color: #ffffff; text-shadow: 0 0 60px rgba(253,175,63,1), 0 0 100px rgba(253,175,63,0.5); }
  100% { color: #FDAF3F; text-shadow: 0 0 30px rgba(253,175,63,0.35); }
}
@keyframes glow-pulse {
  from { text-shadow: 0 0 20px rgba(253,175,63,0.2); }
  to   { text-shadow: 0 0 60px rgba(253,175,63,0.6); }
}

/* ── Subtext ── */
.hero-sub {
  font-size: 1.1rem; color: #C11B2C;
  font-style: italic; font-weight: 600;
  margin-bottom: 1rem;
  opacity: 0; animation: fadeUp 0.6s ease forwards 0.3s;
}
.hero-desc {
  font-size: 1.05rem; color: rgba(245,240,232,0.72);
  line-height: 1.7; margin-bottom: 2.5rem;
  opacity: 0; animation: fadeUp 0.6s ease forwards 0.45s;
}
.br-lg { display: none; }
@media (min-width: 600px) { .br-lg { display: inline; } }

/* ── CTAs ── */
.hero-ctas {
  display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem;
  opacity: 0; animation: fadeUp 0.6s ease forwards 0.6s;
}
.btn-primary {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: #C11B2C; color: #ffffff;
  font-weight: 700; font-size: 1rem; padding: 14px 28px;
  border-radius: 8px; position: relative; overflow: hidden;
  transition: background 0.3s cubic-bezier(0.4,0,0.2,1), transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 4px 20px rgba(193,27,44,0.35);
}
.btn-primary::after {
  content: ''; position: absolute; top: 0; left: -100%;
  width: 60%; height: 100%;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.2), transparent);
  transform: skewX(-20deg); transition: left 0.5s ease;
}
.btn-primary:hover { background: #A01525; transform: scale(1.02); box-shadow: 0 8px 28px rgba(193,27,44,0.45); }
.btn-primary:hover::after { left: 150%; }
.btn-secondary {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: transparent; color: #F5F0E8;
  font-weight: 600; font-size: 1rem; padding: 14px 28px;
  border-radius: 8px; border: 1px solid rgba(245,240,232,0.3);
  transition: border-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
}
.btn-secondary:hover { border-color: #FDAF3F; color: #FDAF3F; transform: translateY(-1px); }

/* ── Badges ── */
.hero-badges {
  display: flex; gap: 0.65rem; flex-wrap: wrap;
  opacity: 0; animation: fadeUp 0.6s ease forwards 0.75s;
}
.hero-badge-pill {
  display: inline-flex; align-items: center; gap: 0.4rem;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.10);
  border-radius: 999px; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  color: rgba(245,240,232,0.80); font-size: 13px; font-weight: 500; padding: 6px 14px;
}
.bp-dot { width: 6px; height: 6px; background: #FDAF3F; border-radius: 50%; flex-shrink: 0; }

/* ── Scroll Indikator ── */
.hero-scroll {
  position: absolute; bottom: 200px; right: 2.5rem;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  color: rgba(245,240,232,0.55); font-size: 11px;
  letter-spacing: 0.12em; text-transform: uppercase; writing-mode: vertical-lr;
  opacity: 0; animation: fadeUp 1s ease forwards 1.2s, bounce-scroll 2.2s ease-in-out infinite 2.5s;
}
.scroll-text { writing-mode: vertical-lr; }
.scroll-line {
  width: 1px; height: 50px;
  background: linear-gradient(to bottom, rgba(253,175,63,0.7), transparent);
  animation: scrollLine 2s ease infinite;
}
@keyframes bounce-scroll {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(8px); }
}
@keyframes scrollLine {
  0%   { transform: scaleY(0); transform-origin: top; }
  50%  { transform: scaleY(1); transform-origin: top; }
  51%  { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
  .hero-scroll { display: none; }
  .hero-badges { gap: 0.5rem; }
  .hero-badge-pill { font-size: 12px; padding: 5px 11px; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-label, .hero-sub, .hero-desc,
  .hero-ctas, .hero-badges, .hero-scroll {
    animation: none !important; opacity: 1 !important; transform: none !important;
  }
  .temp, .label-dot, .scroll-line { animation: none !important; }
  .wave-parallax > use { animation: none !important; }
}
</style>

<script>
  /*
    Count-Up Animation für "167°C"
    ─────────────────────────────────────────────────────────────────
    Easing: easeOutExpo — sehr schnell am Anfang, zieht am Ende
    fast zum Stillstand. Das gibt den "Einrasten bei 167°C"-Effekt.

    Ablauf:
      1. IntersectionObserver wartet bis Hero sichtbar
      2. 300ms Pause (Seite wirkt "settled")
      3. Zählt von START (0) auf 167 mit easeOutExpo
      4. Bei Ankunft: Flash + dauerhafter Glow-Puls
  */

  const TARGET   = 167
  const START    = 0
  const DURATION = 1800  // ms — lang genug um die Kurve zu spüren

  const tempNumber  = document.getElementById('temp-number')
  const tempDisplay = document.getElementById('temp-display')
  const hero        = document.getElementById('hero')

  let hasRun = false

  // easeOutExpo: sehr steil am Anfang, flacht stark ab
  // t=0.1 → 0.50 | t=0.5 → 0.97 | t=0.9 → ~1.0
  // Das ist der "Einrasten"-Effekt: Zahl schießt hoch und bremst sanft ein
  function easeOutExpo(t: number): number {
    return t === 1 ? 1 : 1 - Math.pow(2, -10 * t)
  }

  function runCountUp() {
    if (hasRun) return
    hasRun = true

    // Startwert sofort setzen bevor RAF läuft
    if (tempNumber) tempNumber.textContent = String(START)

    const startTime = performance.now()

    function tick(now: number) {
      const elapsed  = now - startTime
      const progress = Math.min(elapsed / DURATION, 1)
      const eased    = easeOutExpo(progress)
      const current  = Math.round(START + (TARGET - START) * eased)

      if (tempNumber) tempNumber.textContent = String(current)

      if (progress < 1) {
        requestAnimationFrame(tick)
      } else {
        // Sicherstellen dass exakt 167 angezeigt wird
        if (tempNumber) tempNumber.textContent = String(TARGET)
        onDone()
      }
    }

    requestAnimationFrame(tick)
  }

  function onDone() {
    // Flash-Aufblitz, dann Glow
    tempDisplay?.classList.add('flash-active')
    setTimeout(() => {
      tempDisplay?.classList.remove('flash-active')
      tempDisplay?.classList.add('glow-active')
    }, 600)
  }

  // Reduced Motion: direkt Zielwert, kein Counter
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    hasRun = true
    if (tempNumber) tempNumber.textContent = String(TARGET)
    tempDisplay?.classList.add('glow-active')
  } else if (hero && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        setTimeout(runCountUp, 300)
        observer.disconnect()
      }
    }, { threshold: 0.15 })
    observer.observe(hero)
  } else {
    setTimeout(runCountUp, 400)
  }
</script>