---
import { getLinks } from '../lib/sanity'
const links = await getLinks()
---
<nav class="navbar" id="navbar">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <picture>
        <source
          type="image/webp"
          srcset="/logo/logo-300w.webp 300w, /logo/logo-600w.webp 600w"
          sizes="(max-width: 1024px) 300px, 300px"
        />
        <img
          src="/logo/logo.jpeg"
          alt="Beach and Food"
          class="logo-img"
          width="300"
          height="77"
          fetchpriority="high"
        />
      </picture>
    </a>

    <ul class="nav-links">
      <li><a href="/#angebot" class="nav-link">Speisekarte</a></li>
      <li><a href="/#vibes" class="nav-link">Beach Vibes</a></li>
      <li><a href="/#ueber-uns" class="nav-link">Über uns</a></li>
      <li><a href="/#kontakt" class="nav-link">Kontakt</a></li>
      <li><a href={links.voucher} target="_blank" rel="noopener" class="nav-link">🎁 Gutschein</a></li>
    </ul>

    <a href={links.order} target="_blank" rel="noopener" class="nav-cta">
      <span class="cta-text">Jetzt bestellen</span>
      <span class="cta-arrow" aria-hidden="true">→</span>
    </a>

    <button class="burger" id="burger" aria-label="Menü öffnen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <ul>
      <li><a href="/#angebot">Speisekarte</a></li>
      <li><a href="/#vibes">Beach Vibes</a></li>
      <li><a href="/#ueber-uns">Über uns</a></li>
      <li><a href="/#kontakt">Kontakt</a></li>
      <li><a href={links.voucher} target="_blank" rel="noopener">🎁 Gutschein</a></li>
      <li><a href={links.order} target="_blank" rel="noopener" class="nav-cta-mobile">Jetzt bestellen</a></li>
    </ul>
  </div>
</nav>

<style>
/* ─── Basis ─────────────────────────────────────────────────────────── */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #ffffff;
  border-bottom: 1px solid rgba(244, 168, 32, 0.25);
  box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
  border-radius: 0 0 20px 20px;
  transition: box-shadow 0.3s ease;
}
/* Beim Scrollen: kräftigerer Schatten + kompaktere Leiste. */
.navbar.scrolled {
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.12);
}

/* ─── Nav Inner ─────────────────────────────────────────────────────── */
.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-top: 1rem;
  padding-bottom: 1rem;
  transition: padding 0.25s ease;
}
.navbar.scrolled .nav-inner {
  padding-top: 0.6rem;
  padding-bottom: 0.6rem;
}

/* ─── Logo ──────────────────────────────────────────────────────────── */
.logo { display: flex; align-items: center; flex-shrink: 0; }
.logo-img {
  height: 44px;
  width: auto;
  object-fit: contain;
  display: block;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.logo:hover .logo-img { transform: scale(1.05) rotate(-2deg); }

/* ─── Nav Links ─────────────────────────────────────────────────────── */
.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
  margin-left: auto;
}

.nav-link {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--ocean);
  position: relative;
  padding-bottom: 3px;
  transition: color 0.25s ease;
}

/* Amber-Unterlinie — animiert beim Hover */
.nav-link::after {
  content: '';
  display: block;
  height: 2px;
  background: var(--sun-bright);
  border-radius: 2px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
  position: absolute;
  bottom: -2px;
  left: 0; right: 0;
}
.nav-link:hover::after,
.nav-link.active::after {
  transform: scaleX(1);
}
.nav-link:hover { color: var(--sun-bright); }
.nav-link.active { color: var(--sun-bright); font-weight: 600; }

/* ─── CTA-Button ────────────────────────────────────────────────────── */
.nav-cta {
  background: var(--sun);
  color: var(--ocean-deep);
  font-weight: 600;
  font-size: 0.85rem;
  padding: 0.55rem 1.2rem;
  border-radius: 100px;
  white-space: nowrap;
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.2s ease;
}
.nav-cta:hover {
  background: var(--coral);
  transform: scale(1.04);
  box-shadow: 0 4px 16px rgba(244, 168, 32, 0.3);
}

.cta-text {
  display: inline-block;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.25s ease;
}
.nav-cta:hover .cta-text {
  transform: translateX(110%);
  opacity: 0;
}

.cta-arrow {
  position: absolute;
  left: 50%;
  transform: translateX(calc(-50% - 110%));
  opacity: 0;
  font-size: 1.4rem;
  line-height: 1;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.25s ease;
}
.nav-cta:hover .cta-arrow {
  transform: translateX(-50%);
  opacity: 1;
}

/* ─── Burger ────────────────────────────────────────────────────────── */
.burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  margin-left: auto;
  padding: 6px;
  border-radius: 6px;
  transition: background 0.2s;
}
.burger:hover { background: rgba(0, 0, 0, 0.06); }
.burger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--ocean);
  border-radius: 2px;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.25s ease;
}
.burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ─── Mobile Menu ───────────────────────────────────────────────────── */
.mobile-menu {
  max-height: 0;
  overflow: hidden;
  background: var(--sand-light);
  transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.35s ease;
  opacity: 0;
}
.mobile-menu.open {
  max-height: 500px;
  opacity: 1;
  border-radius: 0 0 20px 20px;
}
.mobile-menu ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0.5rem 1.5rem 1.5rem;
}
.mobile-menu li {
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  transform: translateY(-8px);
  opacity: 0;
  transition: transform 0.35s ease, opacity 0.35s ease;
}
.mobile-menu li:last-child { border-bottom: none; }

.mobile-menu.open li:nth-child(1) { transition-delay: 0.05s; }
.mobile-menu.open li:nth-child(2) { transition-delay: 0.10s; }
.mobile-menu.open li:nth-child(3) { transition-delay: 0.15s; }
.mobile-menu.open li:nth-child(4) { transition-delay: 0.20s; }
.mobile-menu.open li:nth-child(5) { transition-delay: 0.25s; }
.mobile-menu.open li:nth-child(6) { transition-delay: 0.30s; }
.mobile-menu:not(.open) li { transition-delay: 0s !important; }
.mobile-menu.open li { transform: translateY(0); opacity: 1; }

.mobile-menu a {
  display: block;
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--ocean);
  padding: 0.9rem 0;
  transition: color 0.2s, padding-left 0.2s;
}
.mobile-menu a:hover { color: var(--sun); padding-left: 0.4rem; }

.nav-cta-mobile {
  display: block;
  text-align: center;
  background: var(--sun);
  color: var(--ocean-deep) !important;
  font-weight: 600;
  padding: 0.75rem 1.4rem !important;
  border-radius: 100px;
  margin-top: 0.5rem;
  margin-bottom: 0.25rem;
  transition: background 0.2s ease;
}
.nav-cta-mobile:hover {
  background: var(--coral) !important;
  padding-left: 0 !important;
}

/* ─── Responsive ────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .nav-links, .nav-cta { display: none; }
  .burger { display: flex; }
}

/* ─── Reduced Motion ────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .nav-link::after,
  .nav-cta,
  .cta-text,
  .cta-arrow,
  .burger span,
  .mobile-menu,
  .mobile-menu li,
  .mobile-menu a,
  .logo-img,
  .nav-inner {
    transition: none !important;
  }
  .logo:hover .logo-img { transform: none; }
}
</style>

<script>
  // ── Hamburger Toggle ───────────────────────────────────────────────
  const burger = document.getElementById('burger')
  const mobileMenu = document.getElementById('mobile-menu')

  burger?.addEventListener('click', () => {
    const isOpen = burger.classList.toggle('open')
    mobileMenu?.classList.toggle('open', isOpen)
    burger.setAttribute('aria-expanded', String(isOpen))
    burger.setAttribute('aria-label', isOpen ? 'Menü schließen' : 'Menü öffnen')
  })

  mobileMenu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      mobileMenu.classList.remove('open')
      burger?.classList.remove('open')
      burger?.setAttribute('aria-expanded', 'false')
      burger?.setAttribute('aria-label', 'Menü öffnen')
    })
  })

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024) {
      mobileMenu?.classList.remove('open')
      burger?.classList.remove('open')
      burger?.setAttribute('aria-expanded', 'false')
    }
  })

  // ── Active-State via IntersectionObserver ──────────────────────────
  // Läuft nur sinnvoll auf der Startseite (dort existieren die Section-IDs).
  // Auf anderen Seiten (z.B. /impressum) findet der Observer schlicht keine
  // Sections und bleibt inaktiv — kein Fehler, kein Crash.
  const sections = ['angebot', 'vibes', 'ueber-uns', 'kontakt']
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-links .nav-link[href^="/#"]')

  const setActive = (id: string) => {
    navLinks.forEach(a => {
      a.classList.toggle('active', a.getAttribute('href') === `/#${id}`)
    })
  }

  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) setActive(entry.target.id)
    })
  }, {
    rootMargin: '-40% 0px -55% 0px',
    threshold: 0,
  })

  sections.forEach(id => {
    const el = document.getElementById(id)
    if (el) sectionObserver.observe(el)
  })

  // ── Scroll-Schatten: .scrolled ab ~12px Scroll-Offset ──────────────
  const navbar = document.getElementById('navbar')
  if (navbar) {
    let ticking = false
    const updateScrolled = () => {
      navbar.classList.toggle('scrolled', window.scrollY > 12)
      ticking = false
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(updateScrolled) }
    }, { passive: true })
    updateScrolled()
  }
</script>
