.badge-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-3px); }
.bc-number { font-family: 'Darwin ALT', 'Darwin ALT Fallback', sans-serif; font-size: 2.4rem; font-weight: 900; color: var(--coral); line-height: 1.1; margin-bottom: 0.3rem; }

/* Signatur-Wert 167°C: dezentes, warmes Hitze-Flimmern (Glow-Puls). */
.bc-heat {
