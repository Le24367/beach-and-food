---
import { getLinks, getSiteSettings } from '../lib/sanity'
import type { PaymentMethod } from '../lib/sanity'

const [links, settings] = await Promise.all([
  getLinks(),
  getSiteSettings().catch(() => null),
])

const paymentMethods: PaymentMethod[] = settings?.paymentMethods ?? [
  { _key: 'ec',    label: 'EC/Kreditkarte', emoji: '💳' },
  { _key: 'apple', label: 'Apple Pay',      emoji: '⌚' },
  { _key: 'gpay',  label: 'G Pay',          emoji: '' },
  { _key: 'pp',    label: 'PayPal',         emoji: '' },
  { _key: 'bar',   label: 'Bar',            emoji: '💵' },
]

const spotifyUrl = links.spotify ?? ''
const spotifyMatch = spotifyUrl.match(/spotify\.com\/(?:intl-[a-z]+\/)?(track|playlist|album)\/([A-Za-z0-9]+)/)
const spotifyType  = spotifyMatch?.[1] ?? 'track'
const spotifyId    = spotifyMatch?.[2] ?? ''

const TRACK_URL = spotifyId ? `https://open.spotify.com/${spotifyType}/${spotifyId}` : '#'
const EMBED_URL = spotifyId ? `https://open.spotify.com/embed/${spotifyType}/${spotifyId}?utm_source=generator&theme=0` : ''

interface SpotifyOEmbed {
  title: string
  thumbnail_url: string
  thumbnail_width: number
  thumbnail_height: number
  provider_name: string
}

let trackTitle  = 'Beach and Food'
let trackArtist = 'Jens & Maria Fox'
let trackCover  = ''

// FIX: Timeout ergänzt (AbortController, 5s). Vorher konnte ein langsamer/
// nicht erreichbarer Spotify-oEmbed-Endpunkt den Build unnötig verzögern,
// da fetch() ohne Timeout im schlimmsten Fall sehr lange auf eine Antwort
// wartet, bevor der Try/Catch überhaupt greift.
try {
  const oembedUrl = `https://open.spotify.com/oembed?url=${encodeURIComponent(TRACK_URL)}`
  const controller = new AbortController()
  const timeout = setTimeout(() => controller.abort(), 5000)
  const res = await fetch(oembedUrl, { signal: controller.signal })
  clearTimeout(timeout)
  if (res.ok) {
    const data: SpotifyOEmbed = await res.json()
    const parts = data.title.split(' - ')
    if (parts.length >= 2) {
      trackTitle  = parts[0].trim()
      trackArtist = parts.slice(1).join(' - ').trim()
    } else {
      trackTitle = data.title
    }
    trackCover = data.thumbnail_url
  }
} catch (e) {
  console.warn('[Bestellen] Spotify oEmbed nicht erreichbar oder Timeout, nutze Fallback.')
}
---

