---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import '../styles/global.css'
import { getSiteSettings } from '../lib/sanity'
import { CONTACT, SITE } from '../lib/config'

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Beach and Food – Foodtruck 2.0 am Sütel-Strand',
  description = 'Fischbrötchen, Currywurst, Pommes und kalte Drinks – direkt am Sütel-Strand auf dem Campingplatz Sütel. Bei exakt 167°C, täglich frisch.'
} = Astro.props;

// Kontaktdaten für JSON-LD: Sanity hat Vorrang, config.ts als Fallback
const settings = await getSiteSettings().catch(() => null)
const telephone = settings?.contact?.telephone ?? CONTACT.telephone
const email     = settings?.contact?.email     ?? CONTACT.email

const canonicalUrl = SITE.url
const ogImage = `${SITE.url}/og-image.jpg`

// JSON-LD: LocalBusiness + FoodEstablishment
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["FoodEstablishment", "LocalBusiness"],
  "name": "Beach and Food",
  "description": description,
  "url": canonicalUrl,
  "logo": `${canonicalUrl}/logo/logo.jpeg`,
  "image": ogImage,
  "telephone": telephone,
  "email": email,
  "priceRange": "€",
  "servesCuisine": ["Fischbrötchen", "Currywurst", "Fast Food"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Sütel Strand",
    "addressLocality": "Neukirchen",
    "postalCode": "23779",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 54.337045,
    "longitude": 11.071475
  },
  "sameAs": [
    "https://www.instagram.com/beachandfood"
  ]
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <!--
    maximum-scale=1.0, user-scalable=no:
    Verhindert Pinch-to-Zoom und Doppeltipp-Zoom auf Mobile.
    user-scalable=no ist für einen Foodtruck-Auftritt üblich und unproblematisch.
  -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- ── PWA ──────────────────────────────────────────────────────── -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1A3A4A" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Beach & Food" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />
  <meta name="msapplication-TileColor" content="#0D2233" />
  <meta name="msapplication-TileImage" content="/icons/icon-192.png" />
  <!-- ── Ende PWA ───────────────────────────────────────────────── -->

  <!--
    Logo früh laden — erstes sichtbares Bild in der Navbar.
    Fonts laufen über global.css mit font-display: swap — kein preload-Link
    nötig, da @fontsource beim Build einen Hash in den Dateinamen einfügt
    und ein hardcodierter Pfad immer 404 erzeugen würde.
  -->
  <link rel="preload" as="image" href="/logo/logo-300w.webp" type="image/webp" fetchpriority="high" />

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Beach and Food" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD Strukturierte Daten -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />
  <Analytics />
  <SpeedInsights />
  <script>
    // ── Scroll reveal ────────────────────────────────────────────────
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // ── Service Worker registrieren ──────────────────────────────────
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker
          .register('/sw.js', { scope: '/' })
          .then((reg) => {
            console.log('[SW] registriert:', reg.scope);
          })
          .catch((err) => {
            console.warn('[SW] Registrierung fehlgeschlagen:', err);
          });
      });
    }
  </script>
</body>
</html>