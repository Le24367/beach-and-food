---
import { getLinks } from '../lib/sanity'
const links = await getLinks()
---
<section class="bestellen" id="bestellen">
  <div class="container">
    <div class="bestellen-card reveal">
      <div class="bc-left">
        <span class="section-label">Online Bestellen</span>
        <h2>Hunger? Spar dir die Wartezeit.</h2>
        <p>Bestelle bequem über dein Smartphone vor und hol dein Essen frisch am Truck ab.</p>
        <div class="bestellen-actions">
          <a href={links.order} target="_blank" rel="noopener" class="btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/></svg>
            Jetzt online bestellen
          </a>
          <a href={links.voucher} target="_blank" rel="noopener" class="btn-gift">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
            Gutschein verschenken
          </a>
        </div>
        <div class="payment-info">
          <span class="pi-label">Wir akzeptieren</span>
          <div class="payment-icons">
            <span class="pi-badge">💳 EC/Kreditkarte</span>
            <span class="pi-badge">⌚ Apple Pay</span>
            <span class="pi-badge">G Pay</span>
            <span class="pi-badge">PayPal</span>
            <span class="pi-badge">💵 Bar</span>
          </div>
        </div>
      </div>
      <div class="bc-right">
        <div class="phone-mockup">
          <div class="phone-screen">
            <div class="pm-header">
              <div class="pm-logo">B&F</div>
              <div class="pm-title">Beach and Food</div>
            </div>
            <div class="pm-items">
              <div class="pm-item">
                <span class="pm-emoji">🐟</span>
                <div class="pm-item-info">
                  <span class="pm-name">Fischbrötchen</span>
                  <span class="pm-sub">Klassiker</span>
                </div>
                <button class="pm-add">+</button>
              </div>
              <div class="pm-item">
                <span class="pm-emoji">🍟</span>
                <div class="pm-item-info">
                  <span class="pm-name">Pommes frites</span>
                  <span class="pm-sub">167°C</span>
                </div>
                <button class="pm-add">+</button>
              </div>
              <div class="pm-item">
                <span class="pm-emoji">🌭</span>
                <div class="pm-item-info">
                  <span class="pm-name">Currywurst</span>
                  <span class="pm-sub">Hausgemacht</span>
                </div>
                <button class="pm-add">+</button>
              </div>
            </div>
            <div class="pm-cta">Jetzt bestellen</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="vibes" id="vibes">
  <div class="vibes-card">
  <div class="container">
    <div class="vibes-inner reveal">
      <span class="section-label" style="color: var(--sun)">Beach Vibes</span>
      <h2>Der perfekte Sound für deinen Strandtag.</h2>
      <p>Unsere Lieblingstracks — gute Laune inklusive.</p>
      <!-- Spotify Embed — Audio-Stream läuft direkt Spotify ↔ User, kein Vercel-Traffic -->
      <div class="spotify-embed-wrap">
        <iframe
          src={`https://open.spotify.com/embed/playlist/${links.spotify.split('/playlist/')[1]}?utm_source=generator&theme=0`}
          width="100%"
          height="352"
          frameborder="0"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          loading="lazy"
          title="Beach and Food Playlist auf Spotify"
        ></iframe>
      </div>
      <!-- Externer Link als Fallback -->
      <a
        href={links.spotify}
        target="_blank"
        rel="noopener"
        class="spotify-open-link"
        aria-label="Playlist in Spotify App öffnen"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="#1DB954"><circle cx="12" cy="12" r="12" fill="#1DB954"/><path fill="white" d="M17.9 10.9C14.7 9 9.35 8.8 6.3 9.75c-.5.15-1-.15-1.15-.6-.15-.5.15-1 .6-1.15C9.65 6.8 15.45 7 19.1 9.15c.45.25.6.85.35 1.3-.25.35-.85.5-1.3.25M17.65 13.5c-.2.35-.6.45-.95.25-2.65-1.6-6.65-2.05-9.75-1.15-.35.1-.75-.1-.85-.45-.1-.35.1-.75.45-.85 3.55-1.05 7.95-.55 10.95 1.3.3.15.4.6.15.9M16.6 16.2c-.15.25-.5.35-.75.2-2.3-1.4-5.2-1.75-8.65-1-.3.1-.55-.15-.65-.4-.1-.3.15-.55.4-.65 3.75-.85 6.95-.5 9.5 1.1.3.15.35.5.15.75"/></svg>
        In Spotify App öffnen
      </a>
    </div>
  </div>
  </div>
</section>

<style>
/* ---- BESTELLEN ---- */
.bestellen {
  padding: 7rem 0;
  background: var(--sand-light);
}
.bestellen-card {
  background: var(--ocean);
  border-radius: 2rem;
  padding: 4rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  overflow: hidden;
  position: relative;
}
.bestellen-card::after {
  content: '';
  position: absolute;
  top: -100px; right: -100px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(244,168,32,0.15) 0%, transparent 70%);
  pointer-events: none;
}
.bc-left .section-label {
  color: var(--sun);
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 1rem;
}
.bc-left h2 {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 900;
  color: var(--foam);
  line-height: 1.15;
  margin-bottom: 1rem;
}
.bc-left p {
  color: rgba(255,255,255,0.65);
  font-size: 1rem;
  line-height: 1.65;
  margin-bottom: 2rem;
}
.bestellen-actions { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem; }
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--sun);
  color: var(--ocean-deep);
  font-weight: 700;
  font-size: 0.95rem;
  padding: 0.85rem 1.8rem;
  border-radius: 100px;
  transition: background 0.2s, transform 0.15s;
}
.btn-primary:hover { background: var(--sun-bright); transform: translateY(-2px); }
.btn-gift {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: rgba(232,93,58,0.12);
  color: var(--coral);
  font-weight: 600;
  font-size: 0.95rem;
  padding: 0.85rem 1.8rem;
  border-radius: 100px;
  border: 1px solid rgba(232,93,58,0.35);
  transition: background 0.2s;
}
.btn-gift:hover { background: rgba(255,255,255,0.18); }
.pi-label {
  display: block;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.4);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 0.5rem;
}
.payment-icons { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.pi-badge {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.65);
  font-size: 0.75rem;
  padding: 0.25rem 0.65rem;
  border-radius: 100px;
}
.bc-right { display: flex; justify-content: center; }
.phone-mockup {
  width: 240px;
  background: #111;
  border-radius: 32px;
  padding: 16px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  position: relative;
  z-index: 1;
}
.phone-screen {
  background: var(--sand-light);
  border-radius: 20px;
  overflow: hidden;
  padding: 1rem;
}
.pm-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
.pm-logo {
  background: var(--ocean);
  color: var(--sun);
  font-weight: 900;
  font-size: 0.7rem;
  padding: 0.3rem 0.5rem;
  border-radius: 6px;
  font-family: 'Playfair Display', serif;
}
.pm-title { font-size: 0.8rem; font-weight: 700; color: var(--ocean-deep); }
.pm-items { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1rem; }
.pm-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: white;
  border-radius: 10px;
  padding: 0.5rem 0.6rem;
}
.pm-emoji { font-size: 1.2rem; }
.pm-item-info { flex: 1; }
.pm-name { display: block; font-size: 0.72rem; font-weight: 600; color: var(--ocean-deep); }
.pm-sub { display: block; font-size: 0.62rem; color: var(--text-muted); }
.pm-add {
  background: var(--sun);
  border: none;
  border-radius: 6px;
  width: 22px; height: 22px;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  color: var(--ocean-deep);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pm-cta {
  background: var(--ocean);
  color: var(--foam);
  text-align: center;
  border-radius: 10px;
  padding: 0.6rem;
  font-size: 0.75rem;
  font-weight: 700;
}

/* ---- VIBES ---- */
.vibes {
  padding: 7rem 0;
  background: transparent;
  position: relative;
  z-index: 1;
}
.vibes .vibes-card {
  background: var(--ocean-deep);
  padding: 6rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));
  clip-path: polygon(0 0%, 100% 4%, 100% 100%, 0% 96%);
}
.vibes-inner {
  max-width: 600px;
  margin: 0 auto;
  text-align: center;
}
.vibes-inner .section-label {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 1rem;
}
.vibes-inner h2 {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 900;
  color: var(--foam);
  line-height: 1.1;
  margin-bottom: 1rem;
}
.vibes-inner > p { color: rgba(255,255,255,0.5); margin-bottom: 2.5rem; }
.spotify-embed-wrap {
  border-radius: var(--radius-lg);
  overflow: hidden;
  /* iFrame lädt lazy — kein Render-Blocking */
}
.spotify-embed-wrap iframe {
  display: block;
  border-radius: var(--radius-lg);
}
.spotify-open-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0.85rem;
  background: rgba(29,185,84,0.12);
  border: 1px solid rgba(29,185,84,0.3);
  color: #1DB954;
  font-size: 0.8rem;
  font-weight: 600;
  padding: 0.35rem 0.85rem;
  border-radius: 100px;
  transition: background 0.2s, transform 0.15s;
}
.spotify-open-link:hover {
  background: rgba(29,185,84,0.25);
  transform: translateY(-1px);
}

@media (max-width: 900px) {
  .bestellen-card { grid-template-columns: 1fr; padding: 2.5rem; gap: 2.5rem; }
  .bc-right { display: none; }
}
</style>