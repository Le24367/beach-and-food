}
@media (max-width: 480px) {
  .uu-badges { grid-template-columns: 1fr; }
  .carousel { height: 300px; }
}
</style>

<script>
  function initYtFacade(facade: HTMLElement) {
    const activate = () => {
      const videoId = facade.dataset.videoid
      if (!videoId) return
      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0&modestbranding=1&color=white`
      iframe.title = 'Beach and Food – Foodtruck am Sütel-Strand'
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      iframe.allowFullscreen = true
      iframe.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:none;'
      facade.innerHTML = ''
      facade.appendChild(iframe)
      facade.removeAttribute('role')
      facade.removeAttribute('tabindex')
      facade.style.cursor = 'default'
    }
    facade.addEventListener('click', activate)
    facade.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate() }
    })
  }

  document.querySelectorAll<HTMLElement>('.yt-facade').forEach(initYtFacade)

  function initCarousel(carouselEl: Element) {
    const slides        = Array.from(carouselEl.querySelectorAll<HTMLElement>('.carousel-slide'))
    const dotsContainer = carouselEl.querySelector<HTMLElement>('.carousel-dots')
    const prevBtn       = carouselEl.querySelector<HTMLButtonElement>('.carousel-prev')
    const nextBtn       = carouselEl.querySelector<HTMLButtonElement>('.carousel-next')

    let current   = 0
    let animating = false
    let autoTimer: ReturnType<typeof setInterval> | null = null
    const total   = slides.length

    if (dotsContainer) {
      dotsContainer.innerHTML = ''
      slides.forEach((_, i) => {
        const dot = document.createElement('button')
        dot.className = 'carousel-dot' + (i === 0 ? ' active' : '')
        dot.setAttribute('aria-label', `Bild ${i + 1}`)
        dot.setAttribute('role', 'tab')
        dot.setAttribute('aria-selected', i === 0 ? 'true' : 'false')
        dot.addEventListener('click', () => { stopAuto(); goTo(i); startAuto() })
        dotsContainer.appendChild(dot)
      })
    }

    slides.forEach((slide, i) => {
      slide.style.transform = i === 0 ? 'translateX(0)' : 'translateX(100%)'
    })

    function updateAria(prev: number, next: number) {
      slides[prev].setAttribute('aria-hidden', 'true')
      slides[next].setAttribute('aria-hidden', 'false')
      dotsContainer?.querySelectorAll<HTMLElement>('.carousel-dot').forEach((dot, i) => {
        dot.setAttribute('aria-selected', i === next ? 'true' : 'false')
      })
    }

    function goTo(index: number, reverse = false) {
      if (animating || index === current) return
      animating = true
      const next      = (index + total) % total
      const direction = reverse ? -1 : 1
      slides[next].style.transition = 'none'
      slides[next].style.transform  = `translateX(${direction * 100}%)`
      slides[next].getBoundingClientRect()
      slides[next].style.transition  = ''
      slides[current].style.transition = ''
      slides[next].style.transform    = 'translateX(0)'
      slides[current].style.transform = `translateX(${-direction * 100}%)`
      dotsContainer?.querySelectorAll('.carousel-dot')[current]?.classList.remove('active')
      dotsContainer?.querySelectorAll('.carousel-dot')[next]?.classList.add('active')
      updateAria(current, next)
      const prevIndex = current
      const fallbackTimer = setTimeout(() => {
        slides[prevIndex].classList.remove('active')
        slides[next].classList.add('active')
        current   = next
        animating = false
      }, 600)
      slides[next].addEventListener('transitionend', () => {
        clearTimeout(fallbackTimer)
        slides[prevIndex].classList.remove('active')
        slides[next].classList.add('active')
        current   = next
        animating = false
      }, { once: true })
    }

    function startAuto() {
      if (total <= 1) return
      // FIX: 4000ms → 7000ms. War zu schnell, um die Bilder/Bildunterschriften
      // in Ruhe anzusehen. 7 Sekunden sind ein gängiger, entspannterer Wert für
      // Bild-Karussells. Bei Bedarf hier einfach die Zahl weiter anpassen.
      autoTimer = setInterval(() => goTo((current + 1) % total), 7000)
    }
    function stopAuto() {
      if (autoTimer) clearInterval(autoTimer)
      autoTimer = null
    }

    const visibilityObserver = new IntersectionObserver(
      (entries) => entries.forEach(e => e.isIntersecting ? startAuto() : stopAuto()),
      { threshold: 0.2 }
    )
    visibilityObserver.observe(carouselEl)

    prevBtn?.addEventListener('click', () => { stopAuto(); goTo((current - 1 + total) % total, true); startAuto() })
    nextBtn?.addEventListener('click', () => { stopAuto(); goTo((current + 1) % total); startAuto() })

    let touchStartX = 0
    carouselEl.addEventListener('touchstart', (e: Event) => {
      touchStartX = (e as TouchEvent).changedTouches[0].clientX
    }, { passive: true })
    carouselEl.addEventListener('touchend', (e: Event) => {
      const diff = touchStartX - (e as TouchEvent).changedTouches[0].clientX
      if (Math.abs(diff) > 40) {
        stopAuto()
        diff > 0 ? goTo((current + 1) % total) : goTo((current - 1 + total) % total, true)
        startAuto()
      }
    }, { passive: true })

    carouselEl.addEventListener('mouseenter', stopAuto)
    carouselEl.addEventListener('mouseleave', startAuto)
  }

  document.querySelectorAll('.carousel').forEach(initCarousel)

  // Count-up: zählt Zahlen mit [data-countup] beim Sichtbarwerden von 0 hoch.
  // Bei reduced-motion bleibt der bereits im HTML stehende Endwert stehen.
  function initCountUp() {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-countup]'))
    if (els.length === 0) return
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return
        const el = entry.target as HTMLElement
        obs.unobserve(el)
        const target = parseInt(el.dataset.countup ?? '0', 10)
        const suffix = el.dataset.suffix ?? ''
        const prefix = el.dataset.prefix ?? ''
        const duration = 1100
        const start = performance.now()
        const step = (now: number) => {
          const p = Math.min((now - start) / duration, 1)
          const eased = 1 - Math.pow(1 - p, 3) // ease-out-cubic
          el.textContent = `${prefix}${Math.round(eased * target)}${suffix}`
          if (p < 1) requestAnimationFrame(step)
        }
        requestAnimationFrame(step)
      })
    }, { threshold: 0.4 })

    els.forEach((el) => io.observe(el))
  }

  initCountUp()

  // Schlangen-Timeline: scroll-gekoppeltes Zeichnen (scrubbt vor & zurück).
  // Ein gemeinsamer Fortschritt (0..1) treibt sowohl die Desktop- als auch
  // die Mobile-Variante an — nur eine davon ist per CSS-Breakpoint sichtbar,
  // aber beide bleiben synchron, falls sich die Fensterbreite ändert.
  //
  // Desktop-Node-Position UND ihr Scroll-Schwellenwert werden zur Laufzeit
  // aus der tatsächlichen Pfadgeometrie (data-snake-x/y + getPointAtLength)
  // berechnet, statt von Hand geschätzte %/Schwellenwerte zu pflegen — der
  // Pfad ist die einzige "Quelle der Wahrheit" und lässt sich gefahrlos
  // weiter anpassen, ohne dass Nodes verrutschen oder zu früh/spät poppen.
  function initSnakeTimeline() {
    const wrap = document.getElementById('uu-timeline')
    if (!wrap) return

    const desktopEl    = wrap.querySelector<HTMLElement>('.snake-desktop')
    const desktopSvg   = wrap.querySelector<SVGSVGElement>('.snake-desktop .snake-svg')
    const desktopDraw  = wrap.querySelector<SVGPathElement>('.snake-desktop .snake-draw')
    const desktopNodes = Array.from(wrap.querySelectorAll<HTMLElement>('.snake-desktop .snake-node'))
    const pinWrap      = wrap.querySelector<HTMLElement>('.snake-desktop-pin')
    const PIN_TOP = 96 // px, entspricht --top: 6rem, lässt die feste Navbar frei
    const mobileDraw   = wrap.querySelector<SVGPathElement>('.snake-mobile .snake-draw')
    const mobileItems  = Array.from(wrap.querySelectorAll<HTMLElement>('.snake-mobile-item'))
    const mobileQuery  = window.matchMedia('(max-width: 900px)')

    const drawPaths = [desktopDraw, mobileDraw].filter((p): p is SVGPathElement => !!p)
    if (drawPaths.length === 0) return

    // Node-Position aus data-snake-x/y (Viewbox-Einheiten) in % umrechnen,
    // und je Node den Pfad-Fortschritt (0..1) finden, bei dem die Linie ihr
    // am nächsten kommt (Abtastung entlang der echten Pfadlänge).
    const desktopThresholds: number[] = desktopNodes.map(() => 0)
    if (desktopDraw && desktopSvg) {
      const vb = desktopSvg.viewBox.baseVal
      const vbW = vb && vb.width  > 0 ? vb.width  : 1200
      const vbH = vb && vb.height > 0 ? vb.height : 500
      const totalLen = desktopDraw.getTotalLength()
      const steps = 300

      desktopNodes.forEach((node, i) => {
        const x = parseFloat(node.dataset.snakeX ?? '0')
        const y = parseFloat(node.dataset.snakeY ?? '0')
        node.style.left = `${(x / vbW) * 100}%`
        node.style.top  = `${(y / vbH) * 100}%`

        let best = 0
        let bestDist = Infinity
        for (let s = 0; s <= steps; s++) {
          const len = (s / steps) * totalLen
          const pt = desktopDraw.getPointAtLength(len)
          const dx = pt.x - x
          const dy = pt.y - y
          const d = dx * dx + dy * dy
          if (d < bestDist) { bestDist = d; best = s / steps }
        }
        desktopThresholds[i] = best
      })
    }
    const mobileThresholds = mobileItems.map((el) => parseFloat(el.dataset.snakeThreshold ?? '0'))

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduceMotion) {
      drawPaths.forEach((p) => { p.style.strokeDashoffset = '0' })
      desktopNodes.forEach((n) => n.classList.add('active'))
      mobileItems.forEach((n) => n.classList.add('active'))
      return
    }

    let ticking = false

    function update() {
      ticking = false

      // Desktop: Fortschritt kommt aus dem hohen .snake-desktop-pin-Runway.
      // .snake-desktop wird dabei per JS "gepinnt" (fixed/absolute je nach
      // Scroll-Position, siehe Kommentar bei .snake-desktop-pin oben --
      // natives position:sticky funktioniert hier nicht) -- dadurch läuft
      // die Zeichnen-Animation über eine deutlich längere, ruhigere
      // Scroll-Strecke statt im alten kurzen 0.7-Viewport-Fenster.
      if (!mobileQuery.matches && pinWrap) {
        const pinRect = pinWrap.getBoundingClientRect()
        const vh = window.innerHeight
        const scrollable = pinRect.height - vh
        const raw = scrollable > 0 ? -pinRect.top / scrollable : 0
        const progress = Math.min(Math.max(raw, 0), 1)

        if (desktopEl) {
          if (pinRect.top > 0) {
            // Runway noch nicht erreicht -- normaler Fluss oben im Wrapper.
            desktopEl.style.position = 'relative'
            desktopEl.style.top = ''
            desktopEl.style.bottom = ''
            desktopEl.style.left = ''
            desktopEl.style.width = ''
          } else if (pinRect.bottom <= vh) {
            // Runway durchgescrollt -- unten im Wrapper parken, damit der
            // Übergang zurück in den normalen Fluss nahtlos ist.
            desktopEl.style.position = 'absolute'
            desktopEl.style.top = ''
            desktopEl.style.bottom = '0'
            desktopEl.style.left = '0'
            desktopEl.style.width = '100%'
          } else {
            // Mittendrin -- am Viewport fixiert, Navbar bleibt frei.
            desktopEl.style.position = 'fixed'
            desktopEl.style.top = `${PIN_TOP}px`
            desktopEl.style.bottom = ''
            desktopEl.style.left = `${pinRect.left}px`
            desktopEl.style.width = `${pinRect.width}px`
          }
        }

        if (desktopDraw) desktopDraw.style.strokeDashoffset = String(1 - progress)
        desktopNodes.forEach((n, i) => n.classList.toggle('active', progress >= desktopThresholds[i]))
      }

      // Mobile: unverändert das bisherige feste Scroll-Fenster (kein Pin --
      // Scroll-Jacking auf Touch-Geräten fühlt sich schnell falsch an, und
      // die einfache vertikale Liste braucht keine lange Bühne).
      if (mobileQuery.matches) {
        const rect = wrap!.getBoundingClientRect()
        const vh = window.innerHeight
        const start = vh * 0.85
        const end = vh * 0.15
        const raw = (start - rect.top) / (start - end)
        const progress = Math.min(Math.max(raw, 0), 1)

        if (mobileDraw) mobileDraw.style.strokeDashoffset = String(1 - progress)
        mobileItems.forEach((n, i) => n.classList.toggle('active', progress >= mobileThresholds[i]))
      }
    }

    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update) }
    }, { passive: true })
    window.addEventListener('resize', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update) }
    })

    update()
  }

  initSnakeTimeline()
</script>