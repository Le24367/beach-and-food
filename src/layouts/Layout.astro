---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import '../styles/global.css'

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Beach and Food – Foodtruck 2.0 am Sütel-Strand',
  description = 'Fischbrötchen, Currywurst, Pommes und kalte Drinks – direkt am Sütel-Strand auf dem Campingplatz Sütel. Bei exakt 167°C, täglich frisch.'
} = Astro.props;

const canonicalUrl = 'https://beachandfood.de';
const ogImage = 'https://beachandfood.de/og-image.jpg';

// JSON-LD: LocalBusiness + FoodEstablishment
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["FoodEstablishment", "LocalBusiness"],
  "name": "Beach and Food",
  "description": description,
  "url": canonicalUrl,
  "logo": `${canonicalUrl}/logo/logo.jpeg`,
  "image": ogImage,
  "telephone": "+4915164652760",
  "email": "info@beachandfood.de",
  "priceRange": "€",
  "servesCuisine": ["Fischbrötchen", "Currywurst", "Fast Food"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Sütel Strand",
    "addressLocality": "Neukirchen",
    "postalCode": "23779",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 54.337045,
    "longitude": 11.071475
  },
  "sameAs": [
    "https://www.instagram.com/beachandfood"
  ]
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- LCP Preload: Logo wird als erstes sichtbares Bild vorgeladen -->
  <link rel="preload" as="image" href="/logo/logo.jpeg" fetchpriority="high" />

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Beach and Food" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD Strukturierte Daten -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />
  <Analytics />
  <SpeedInsights />
  <script>
    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>