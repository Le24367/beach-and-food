---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Angebot from '../components/Angebot.astro';
import UeberUns from '../components/UeberUns.astro';
import Bestellen from '../components/Bestellen.astro';
import Kontakt from '../components/Kontakt.astro';

// Reihenfolge im DOM entspricht jetzt der Navbar-Navigation:
// #angebot → #ueber-uns → #vibes (in Bestellen.astro) → #bestellen → #kontakt
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Angebot />
    <UeberUns />
    <Bestellen />
    <Kontakt />
  </main>
</Layout>