---
// BusLoader.astro
// Vollbild-Ladescreen: Bus fährt groß rein, Räder rollen physikalisch exakt,
// Zoom zur Tür, dann erscheint ein Willkommens-Screen (Fade-in/Fade-out),
// danach ist direkt die Speisekarte da. Läuft nur einmal pro Browser-Sitzung
// (sessionStorage).
import busWebp from '../assets/bus/bus-body-nowheels.webp'
import busPng from '../assets/bus/bus-body-nowheels.png'
import wheelFrontWebp from '../assets/bus/wheel-front.webp'
import wheelBackWebp from '../assets/bus/wheel-back.webp'
---

<!-- Synchron VOR jeglichem Paint entscheiden, ob das Intro läuft — verhindert
     einen sichtbaren Scroll-Flash, bevor JS unten die Klasse setzen könnte. -->
<script is:inline>
  (function () {
    try {
      var played = sessionStorage.getItem('baf_intro_played');
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var conn = navigator.connection;
      var slow = conn && (conn.effectiveType === 'slow-2g' || conn.effectiveType === '2g');
      if (!played && !reduceMotion && !slow) {
        // intro-loading steuert NUR die Sichtbarkeit des Loaders (display:block)
        // und bleibt bis zum tatsächlichen Entfernen aus dem DOM bestehen.
        // intro-active steuert NUR den Scroll-Lock (global.css) und wird schon
        // beim Start des Fade-outs entfernt — beide dürfen nicht an derselben
        // Klasse hängen, sonst verschwindet der Loader beim Fade-out per
        // display:none hart statt sanft über die Opacity-Transition.
        document.documentElement.classList.add('intro-active', 'intro-pending', 'intro-loading');
      }
    } catch (e) {
      // sessionStorage kann in seltenen Privacy-Modi fehlschlagen — dann läuft
      // die Seite einfach ohne Intro-Lock weiter, kein harter Fehler.
    }
  })();
</script>

<!-- Ohne JS: Loader nie zeigen, Seite sofort nutzbar. -->
<noscript>
  <style>
    #bus-loader { display: none !important; }
  </style>
</noscript>

<div id="bus-loader" class="bus-loader">
  <!-- Szene-Wrapper: fasst Himmel, Strand UND Bus zusammen, damit beim
       Türzoom die GANZE Umgebung mitskaliert statt nur der Bus isoliert --
       sonst wirkt es, als würde der Bus wachsen/näherkommen, statt dass man
       selbst auf ihn zugeht. Transform-Origin sitzt exakt auf der Tür
       (--door-x/--door-y, per JS gesetzt), damit die Tür beim Skalieren
       bildfest bleibt und alles andere davon wegzoomt -- wie eine echte
       Vorwärtsbewegung der Kamera, nicht wie ein wachsendes Objekt. -->
  <div class="loader-scene" id="loaderScene">
    <div class="loader-sky"></div>

    <!-- Atmosphäre: läuft in Dauerschleife unabhängig von der Bus-Sequenz,
         damit die Szene schon lebendig wirkt, bevor überhaupt etwas fährt. -->
    <div class="loader-sun" aria-hidden="true"></div>
    <div class="loader-cloud cloud-1" aria-hidden="true"></div>
    <div class="loader-cloud cloud-2" aria-hidden="true"></div>
    <div class="loader-cloud cloud-3" aria-hidden="true"></div>
    <!-- Jede Möwe besteht aus zwei getrennten Flügel-Pfaden (statt einem
         durchgehenden Strich), die beide um denselben Mittelpunkt (12,8)
         rotieren -- das schlägt zuverlässig per klassischem CSS-Transform
         (siehe .gull-wing), statt die SVG-Pfadform selbst zu animieren
         (dafür ist Browser-Unterstützung inkonsistent). -->
    <svg class="loader-gull gull-1" aria-hidden="true" viewBox="0 0 24 12" xmlns="http://www.w3.org/2000/svg">
      <path class="gull-wing gull-wing-left" d="M12 8 Q6 2 1 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <path class="gull-wing gull-wing-right" d="M12 8 Q18 2 23 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <svg class="loader-gull gull-2" aria-hidden="true" viewBox="0 0 24 12" xmlns="http://www.w3.org/2000/svg">
      <path class="gull-wing gull-wing-left" d="M12 8 Q6 2 1 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <path class="gull-wing gull-wing-right" d="M12 8 Q18 2 23 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <svg class="loader-gull gull-3" aria-hidden="true" viewBox="0 0 24 12" xmlns="http://www.w3.org/2000/svg">
      <path class="gull-wing gull-wing-left" d="M12 8 Q6 2 1 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      <path class="gull-wing gull-wing-right" d="M12 8 Q18 2 23 8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>

    <div class="loader-beach" aria-hidden="true">
      <div class="loader-foam-line" aria-hidden="true"></div>
    </div>

    <div class="bus-wrap" id="loaderBusWrap">
    <!-- Bodenschatten, damit der Bus sichtbar auf dem Strandband steht statt
         zu schweben -- liegt unter der Suspension (eigene Bounce-Klasse),
         damit er beim Einfedern kurz mitreagiert statt starr zu bleiben. -->
    <div class="bus-shadow" id="loaderBusShadow" aria-hidden="true"></div>

    <!-- Innerer Wrapper nur fürs Einfeder-Wippen beim Stopp (translateY/
         scaleY) — getrennt von .bus-wrap, das left (Anfahrt) und den
         Zoom/Fade zur Tür steuert, damit sich die Transitions nicht in die
         Quere kommen. -->
    <div class="bus-suspension" id="loaderSuspension">
      <picture>
        <source srcset={busWebp.src} type="image/webp" />
        <img
          src={busPng.src}
          alt=""
          aria-hidden="true"
          class="bus-body"
          width={busPng.width}
          height={busPng.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <div class="wheel-well well-front"></div>
      <div class="wheel-well well-back"></div>

      <div class="wheel wheel-front" id="loaderWheelFront">
        <picture>
          <source srcset={wheelFrontWebp.src} type="image/webp" />
          <img src={wheelFrontWebp.src} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
        </picture>
      </div>

      <div class="wheel wheel-back" id="loaderWheelBack">
        <picture>
          <source srcset={wheelBackWebp.src} type="image/webp" />
          <img src={wheelBackWebp.src} alt="" aria-hidden="true" loading="eager" fetchpriority="high" />
        </picture>
      </div>

      <!-- Kleiner Staubwirbel am Hinterrad, blitzt beim Ausfedern kurz auf. -->
      <div class="dust-puff" id="loaderDust" aria-hidden="true"></div>

      <!-- Durchgehender Staubschweif, der nur während der Fahrt (Klasse
           "driving" auf .bus-wrap) läuft -- gibt der Einfahrt mehr
           Fahrtgefühl statt nur dem einen Puff beim Anhalten. -->
      <div class="dust-trail" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>

      <!-- Echte Einstiegstür direkt links neben der Bestellausgabe (~35-45%
           Busbreite, unterhalb des Logo-Schwungs). Liegt exakt über der ins
           Busbild gemalten Tür (schlichte Glasscheibe + Ausgabe-Box, von
           einem Rahmen umschlossen), in denselben Farben nachgebaut, damit
           sie im Ruhezustand nahtlos wirkt. Nur die linke Scheibe (der
           eigentliche Türflügel) klappt auf (scaleX-Zusammenklappen am
           linken Anschlag) -- die rechte Seite mit der Ausgabe-Box ist fest
           montiertes Equipment und bleibt stehen. Öffnet sich während des
           Zooms -> wirkt wie ein Durchgehen durch die Tür, ohne Figur. -->
      <div class="door-group" id="loaderDoor" aria-hidden="true">
        <div class="door-interior" id="loaderDoorInterior"></div>
        <div class="door-leaf" id="loaderDoorLeaf">
          <span class="door-frame-left"></span>
          <span class="door-pane-left"></span>
        </div>
        <div class="door-static">
          <span class="door-mullion"></span>
          <span class="door-pane-right">
            <span class="door-glass"></span>
            <span class="door-ledge"></span>
            <span class="door-panel">
              <span class="door-vent-light"></span>
              <span class="door-vent-dark"></span>
            </span>
          </span>
          <span class="door-frame-right"></span>
        </div>
      </div>
    </div>
  </div>
  </div>

  <!-- Dunkel-Portal: eine auflösungs-unabhängige dunkle Fläche, die per
       clip-path-Iris exakt aus der Türöffnung heraus aufgeht und den Screen
       sauber füllt (kein Pixelmatsch wie beim tiefen Raster-Zoom). Liegt
       über dem Bus, unter dem Willkommens-Screen. -->
  <div class="entry-void" id="loaderEntryVoid" aria-hidden="true"></div>

  <!-- Willkommens-Screen: erscheint per Fade-in, sobald das Dunkel-Portal
       den Screen gefüllt hat, bleibt kurz stehen, fährt dann zusammen mit
       dem ganzen Overlay nach oben raus (.slide-out) -> direkt dahinter ist
       die Speisekarte, die gleichzeitig von unten reinfährt. -->
  <div class="loader-welcome" id="loaderWelcome" aria-hidden="true">
    <h1>Moin, willkommen bei</h1>
    <div class="loader-logo-badge">
      <picture>
        <source
          type="image/webp"
          srcset="/logo/logo-footer-200w.webp 200w, /logo/logo-footer-400w.webp 400w"
          sizes="200px"
        />
        <img
          src="/logo/logo.jpeg"
          alt="Beach and Food"
          class="loader-logo-img"
          width="200"
          height="51"
        />
      </picture>
    </div>
  </div>
</div>

<style>
  .bus-loader {
    /* Bewusst position:absolute statt fixed: iOS Safari (bestätigt u.a. für
       iOS 26) rendert fixed-Elemente grundsätzlich NICHT hinter den
       transluzenten oberen/unteren Leisten -- völlig unabhängig von
       viewport-fit=cover, das nur env(safe-area-inset-*) freischaltet, aber
       dieses Fixed-Verhalten nicht überschreiben kann. Normaler (nicht
       fixed) Dokument-Inhalt darf dagegen hinter die Leisten laufen -- genau
       das nutzt der Rest der Seite bereits aus. Der Loader wird daher oben
       im Dokument verankert (top/left/right statt inset) mit expliziter
       Viewport-Höhe (dvh-Fallback-Kette). Kein Scroll-Risiko: html.intro-
       active sperrt overflow bereits vollständig (siehe global.css) und die
       Seite steht beim Laden ohnehin auf Scroll-Position 0. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* 100lvh ("large viewport height") statt dvh: dvh würde mit der
       Toolbar-Höhe mitschrumpfen/wachsen -- wir wollen bewusst IMMER die
       größtmögliche Ausdehnung (Bildschirm komplett inkl. Bereich hinter den
       Leisten), nicht die aktuell sichtbare Fläche. Etwas zu hoch ist
       unkritisch (Scroll ist während des Intros ohnehin gesperrt), zu
       niedrig würde die Speisekarte am unteren Rand durchschimmern lassen. */
    height: 100vh;
    height: 100lvh;
    z-index: 9999;
    overflow: hidden;
    background: var(--ocean-deep);
    touch-action: none;
    overscroll-behavior: contain;
    will-change: transform;
    /* Verhindert, dass der Loader bei einem Reload ohne Intro (kein JS-Setup
       oben nötig) trotzdem kurz aufblitzt — Standard ist unsichtbar/weg,
       das Script unten schaltet ihn nur bei laufendem Intro sichtbar. */
    display: none;
  }
  /* Bewusst NICHT an intro-active gekoppelt: intro-active wird schon beim
     Start des Slide-outs entfernt (steuert den Scroll-Lock), intro-loading
     erst wenn der Loader tatsächlich aus dem DOM entfernt wird -> display
     bleibt "block", solange die Transform-Transition läuft. */
  html.intro-pending .bus-loader,
  html.intro-loading .bus-loader {
    display: block;
  }

  /* Mehrstufiger Himmel statt einer flachen Fläche: dunkles Meeresblau oben,
     über --ocean/--wave sanft heller Richtung Horizont -- der bestehende
     Sonnen-Glow-Fleck bleibt als zusätzlicher Layer obendrauf erhalten. */
  .loader-sky {
    position: absolute;
    inset: 0;
    /* Kein Landschafts-Himmel mehr, sondern der cleane Seiten-Look: eine
       ruhige Sand-Creme-Fläche (--sand-light) wie die hellen Sektionen der
       Seite -- nur mit einem dezenten warmen Sonnen-Glow oben rechts als
       Akzent, damit die Fläche nicht völlig tot wirkt. */
    background:
      radial-gradient(circle at 84% 14%, rgba(244,168,32,0.14) 0%, transparent 52%),
      var(--sand-light);
  }

  /* Cleaner Marken-Look: Sonne, Wolken und der Wellensaum bleiben aus --
     der Hintergrund soll überwiegend wie die cleane Seite wirken. Möwen
     sind bewusst ausgenommen (siehe unten): der leere Himmel wirkte sonst
     zu tot, ein paar fliegende Möwen beleben die Szene, ohne wie eine volle
     Landschafts-Illustration zu wirken. */
  .loader-sun,
  .loader-cloud,
  .loader-foam-line {
    display: none !important;
  }

  /* Sonne mit weichem Halo, atmet leicht -- sonst wäre der Himmel trotz
     Verlauf immer noch komplett regungslos. */
  .loader-sun {
    position: absolute;
    top: 8%;
    left: 78%;
    width: 6.5vw;
    height: 6.5vw;
    min-width: 46px;
    min-height: 46px;
    max-width: 90px;
    max-height: 90px;
    transform: translate(-50%, 0);
    border-radius: 50%;
    background: radial-gradient(circle, var(--sun-bright) 0%, var(--sun) 70%, transparent 100%);
    box-shadow: 0 0 60px 18px rgba(244,168,32,0.35);
    z-index: 0;
    animation: sun-pulse 5s ease-in-out infinite;
  }
  @keyframes sun-pulse {
    0%, 100% { transform: translate(-50%, 0) scale(1); opacity: 0.92; }
    50%      { transform: translate(-50%, 0) scale(1.05); opacity: 1; }
  }

  /* Driftende Wolken -- weiche, verschwommene Ellipsen statt gezeichneter
     Cumulus-Form, damit sie sich in den flachen Verlaufs-Look der Seite
     einfügen statt wie ein Fremdkörper zu wirken. Lange, unterschiedliche
     Laufzeiten + negative Delays -> laufen nie synchron, stehen beim
     ersten Sichtbarwerden schon an unterschiedlichen Positionen. */
  .loader-cloud {
    position: absolute;
    z-index: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.55);
    filter: blur(6px);
    pointer-events: none;
  }
  .cloud-1 { top: 14%; width: 14vw; height: 3.2vw; max-width: 180px; max-height: 42px; animation: cloud-drift 58s linear infinite; animation-delay: -12s; }
  .cloud-2 { top: 24%; width: 10vw; height: 2.4vw; max-width: 130px; max-height: 32px; opacity: 0.7; animation: cloud-drift 74s linear infinite; animation-delay: -40s; }
  .cloud-3 { top: 9%;  width: 8vw;  height: 2vw;   max-width: 100px; max-height: 26px; opacity: 0.5; animation: cloud-drift 90s linear infinite; animation-delay: -65s; }
  @keyframes cloud-drift {
    from { transform: translateX(-25vw); }
    to   { transform: translateX(125vw); }
  }

  /* Kleine Möwen -- reiner Stroke-Pfad (kein Fill). Fliegen bewusst NICHT
     parallel in dieselbe Richtung (das wirkte wie drei Strichmännchen im
     Gleichschritt), sondern auf sich kreuzenden Diagonalen in
     unterschiedliche Richtungen -- eine steigt von unten links nach oben
     rechts, eine sinkt von oben rechts nach unten links, eine quert steil.
     Bleiben dabei komfortabel oberhalb des Strandbands (max. ~45vh), damit
     sie nicht optisch durch Bus oder Strand "fliegen". */
  .loader-gull {
    position: absolute;
    /* top/left: 0 -- die Flugbahnen unten steuern die Position komplett
       selbst über translate() in vw/vh, ausgehend von der oberen linken
       Ecke der Szene. */
    top: 0;
    left: 0;
    width: 34px;
    height: 17px;
    color: rgba(13,34,51,0.55);
    z-index: 1;
    pointer-events: none;
  }
  /* Flügelschlag über klassisches CSS-Transform statt SVG-Pfadform-Animation
     (letzteres hatte inkonsistente Browser-Unterstützung und kam beim Nutzer
     nicht sichtbar an). Jeder Flügel ist ein eigener Pfad, der um den
     gemeinsamen Körper-Mittelpunkt (12,8 -- exakt die Pivot-Koordinate aus
     dem viewBox "0 0 24 12") rotiert: linker Flügel im Uhrzeigersinn, rechter
     gegen den Uhrzeigersinn -> beide Spitzen senken sich synchron ab und
     heben sich wieder, wie ein echter Flügelschlag. transform-box: view-box
     sorgt dafür, dass transform-origin dieselben Koordinaten wie das "d"
     nutzt (sonst würde je nach Browser die eigene Bounding-Box des Pfads
     als Bezugspunkt gelten). */
  .loader-gull .gull-wing {
    transform-box: view-box;
    transform-origin: 12px 8px;
  }
  .loader-gull .gull-wing-left {
    animation: gull-flap-left 0.42s ease-in-out infinite;
  }
  .loader-gull .gull-wing-right {
    animation: gull-flap-right 0.42s ease-in-out infinite;
  }
  @keyframes gull-flap-left {
    0%, 100% { transform: rotate(0deg); }
    50%      { transform: rotate(26deg); }
  }
  @keyframes gull-flap-right {
    0%, 100% { transform: rotate(0deg); }
    50%      { transform: rotate(-26deg); }
  }

  .gull-1 {
    animation: gull-path-1 16s linear infinite;
    animation-delay: -3s;
  }
  .gull-1 .gull-wing { animation-duration: 0.4s; animation-delay: -0.1s; }
  @keyframes gull-path-1 {
    0%   { transform: translate(-10vw, 22vh) rotate(-10deg); }
    50%  { transform: translate(55vw, -4vh) rotate(-6deg); }
    100% { transform: translate(122vw, -22vh) rotate(-10deg); }
  }

  .gull-2 {
    width: 26px;
    height: 13px;
    animation: gull-path-2 19s linear infinite;
    animation-delay: -11s;
  }
  .gull-2 .gull-wing { animation-duration: 0.52s; animation-delay: -0.3s; }
  @keyframes gull-path-2 {
    0%   { transform: translate(112vw, -8vh) rotate(14deg); }
    50%  { transform: translate(48vw, 16vh) rotate(10deg); }
    100% { transform: translate(-16vw, 38vh) rotate(14deg); }
  }

  .gull-3 {
    width: 22px;
    height: 11px;
    opacity: 0.8;
    animation: gull-path-3 12s linear infinite;
    animation-delay: -6s;
  }
  .gull-3 .gull-wing { animation-duration: 0.34s; animation-delay: -0.05s; }
  @keyframes gull-path-3 {
    0%   { transform: translate(-8vw, -4vh) rotate(18deg); }
    50%  { transform: translate(52vw, 20vh) rotate(14deg); }
    100% { transform: translate(116vw, 44vh) rotate(18deg); }
  }

  .loader-beach {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    /* + env(safe-area-inset-bottom): das Band selbst bleedet weiterhin bis
       zum echten Bildschirmrand durch (kein harter Schnitt an der
       transparenten unteren Safari-Leiste, siehe viewport-fit=cover in
       Layout.astro) -- nur die sichtbare Oberkante wandert um den Inset nach
       oben, siehe auch .bus-wrap unten, das im selben Maß mitwandert, damit
       Bus und Bandkante weiterhin zusammenpassen. */
    height: calc(21vh + env(safe-area-inset-bottom, 0px));
    min-height: 158px;
    /* "Boden"-Band, auf dem der Bus steht -- greift das Signatur-Motiv der
       Seite auf: tiefes Ozeanblau (--ocean-deep) mit weichem Radial-Glow wie
       die dunklen Sektionen (.ueber-uns/.vibes) und einer schrägen Oberkante
       (clip-path) im selben diagonalen Stil wie deren Section-Übergänge.
       Höhe so gewählt, dass die Radaufstandslinie des Busses (die durch den
       transparenten Rand der Wheel-Assets ~5vh über der Bus-Unterkante liegt)
       genau auf der Bandkante sitzt -> der Bus steht auf dem Band, statt zu
       schweben. */
    background:
      radial-gradient(circle at 50% 130%, rgba(46,110,126,0.45) 0%, transparent 58%),
      linear-gradient(to bottom, var(--ocean) 0%, var(--ocean-deep) 72%);
    clip-path: polygon(0 6%, 100% 0%, 100% 100%, 0% 100%);
    z-index: 1;
  }
  /* Schimmernder Wellensaum am Übergang Himmel/Strand -- deutet einen
     Wellenrand an, ohne eine echte Wellenform zeichnen zu müssen. */
  .loader-foam-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.65), transparent);
    overflow: hidden;
  }
  .loader-foam-line::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.9), transparent);
    animation: foam-shimmer 6s ease-in-out infinite;
  }

  /* Sobald in die Tür gezoomt wird, blendet die ganze Atmosphäre (Sonne,
     Wolken, Möwen, Wellensaum) mit aus -- soll beim Willkommens-Screen
     nicht mehr zu sehen sein, damit Logo/Text ungestört im Fokus stehen. */
  .bus-loader.atmosphere-hidden .loader-sun,
  .bus-loader.atmosphere-hidden .loader-cloud,
  .bus-loader.atmosphere-hidden .loader-gull,
  .bus-loader.atmosphere-hidden .loader-foam-line {
    /* .loader-sun hat eine eigene @keyframes-Animation, die opacity
       mitanimiert (sun-pulse) -- die würde einen statischen opacity:0-Wert
       jeden Frame wieder überschreiben. Deshalb hier zusätzlich die
       laufende Animation stoppen, sonst greift der Fade-out nicht. */
    animation: none;
    opacity: 0;
    transition: opacity 1s ease-out;
  }
  @keyframes foam-shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(350%); }
  }

  /* Fasst Himmel, Strand und Bus zu einer Einheit zusammen, damit der
     Türzoom die GESAMTE Szene von der Tür aus skaliert (siehe .zoom unten)
     -- füllt immer exakt den Loader, unabhängig davon, ob gerade skaliert
     wird oder nicht. transform-origin sitzt exakt auf der Tür (--door-x/
     --door-y, per JS aus der echten Türposition gesetzt), damit die Tür
     beim Skalieren bildfest bleibt. */
  .loader-scene {
    position: absolute;
    inset: 0;
    transform-origin: var(--door-x, 40%) var(--door-y, 55%);
  }

  .bus-wrap {
    position: absolute;
    /* Etwas größer als zuvor (war 70%/1000px) -- füllt den sonst sehr leeren
       oberen Himmelsbereich besser aus. left entsprechend weiter nach links
       verschoben, damit der Bus bei größerer Breite weiterhin komplett
       offscreen startet, statt schon einen Rand sichtbar zu zeigen. */
    left: -82%;
    /* + env(safe-area-inset-bottom): hält den Bus im selben Maß über der
       Bandkante wie .loader-beach oben mitwächst -- auf Desktop ist der
       Inset 0px, also folgenlos. */
    bottom: calc(15vh + env(safe-area-inset-bottom, 0px));
    width: 76%;
    max-width: 1100px;
    z-index: 3;
    will-change: left, filter;
  }
  .bus-body { width: 100%; height: auto; display: block; }

  /* Weicher Bodenschatten unter dem Bus -- ohne ihn wirkte der Bus, als würde
     er über dem Strandband schweben statt fest darauf zu stehen. Liegt
     unter der Suspension (z-index 0), reagiert aber über eine eigene Klasse
     (shadow-settle, siehe Script) leicht mit, wenn der Bus beim Anhalten
     einfedert. */
  .bus-shadow {
    position: absolute;
    left: 10%;
    right: 16%;
    bottom: 1.5%;
    height: 5.5%;
    z-index: 0;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(6,18,28,0.4) 0%, rgba(6,18,28,0.2) 55%, transparent 78%);
    filter: blur(2px);
  }
  .bus-shadow.shadow-settle {
    animation: shadow-settle 0.42s cubic-bezier(.36,.07,.19,.97);
  }
  @keyframes shadow-settle {
    0%   { transform: scaleX(1) scaleY(1); }
    35%  { transform: scaleX(1.06) scaleY(0.88); }
    65%  { transform: scaleX(0.98) scaleY(1.04); }
    100% { transform: scaleX(1) scaleY(1); }
  }

  .bus-suspension {
    position: relative;
    width: 100%;
  }
  .bus-suspension.settle {
    animation: bus-settle 0.42s cubic-bezier(.36,.07,.19,.97);
  }
  @keyframes bus-settle {
    0%   { transform: translateY(0) scaleY(1); }
    35%  { transform: translateY(3.5px) scaleY(0.986); }
    65%  { transform: translateY(-1px) scaleY(1.004); }
    100% { transform: translateY(0) scaleY(1); }
  }

  .dust-puff {
    position: absolute;
    left: 62.5%;
    bottom: 6%;
    width: 9%;
    padding-top: 9%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(214,201,173,0.55) 0%, rgba(214,201,173,0.22) 45%, transparent 75%);
    opacity: 0;
    transform: scale(0.55);
    pointer-events: none;
    z-index: 2;
  }
  .dust-puff.puff {
    animation: dust-puff 0.6s ease-out forwards;
  }
  @keyframes dust-puff {
    0%   { opacity: 0; transform: scale(0.5); }
    25%  { opacity: 0.7; }
    100% { opacity: 0; transform: scale(1.6); }
  }

  /* Staubschweif während der Fahrt: drei versetzt animierte Puffs, die nur
     laufen, solange .bus-wrap die Klasse "driving" trägt (siehe Script) --
     dadurch bleibt es exakt auf die eigentliche Fahrtstrecke begrenzt, statt
     eine feste Animationsdauer erraten zu müssen. Die Puffs wandern relativ
     zum Bus nach hinten (translateX negativ), wirken so wie ein Schweif, der
     hinter dem fahrenden Bus zurückbleibt. */
  .dust-trail {
    position: absolute;
    left: 60%;
    bottom: 4%;
    width: 8%;
    padding-top: 8%;
    z-index: 2;
    pointer-events: none;
  }
  .dust-trail span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(214,201,173,0.5) 0%, rgba(214,201,173,0.18) 45%, transparent 75%);
    opacity: 0;
  }
  .bus-wrap.driving .dust-trail span {
    animation: dust-trail-puff 0.9s ease-out infinite;
  }
  .bus-wrap.driving .dust-trail span:nth-child(2) { animation-delay: 0.3s; }
  .bus-wrap.driving .dust-trail span:nth-child(3) { animation-delay: 0.6s; }
  @keyframes dust-trail-puff {
    0%   { opacity: 0; transform: translateX(0) scale(0.4); }
    20%  { opacity: 0.5; }
    100% { opacity: 0; transform: translateX(-140%) scale(1.3); }
  }

  /* Türgruppe: exakt über der ins Busbild gemalten Tür (x ca. 492-636px von
     1400px Bildbreite, y ca. 146-372px von 472px Bildhöhe -> in % der
     Busbreite/-höhe umgerechnet, damit es mit dem Mobile-Layout mitskaliert.
     Oben bewusst erst ab y146 statt am Türrahmen-Anfang, weil der gemalte
     Logo-Schwung bis dahin überlappt -> sonst würde unsere Überlagerung
     einen Teil des Logos verdecken. */
  .door-group {
    position: absolute;
    left: 35.1%;
    width: 10.3%;
    top: 30.9%;
    height: 47.9%;
    z-index: 4;
  }
  /* Nur unter der linken Scheibe (dem eigentlichen Türflügel) liegt ein
     dunkler Innenraum-Filler. Gradient + Inset-Schatten geben echte Tiefe:
     stockdunkel am Scharnier (links), minimal angehoben zur Öffnung -> liest
     sich als Kavität in den Bus hinein, nicht als flaches Rechteck. Die
     rechte Seite (Ausgabe-Box) bewegt sich nie, braucht nichts dahinter. */
  .door-interior {
    position: absolute;
    left: 0; width: 41.7%; top: 0; bottom: 0;
    z-index: 1;
    background: linear-gradient(to right, #05070b 0%, #0b0f17 55%, #161b28 100%);
    box-shadow: inset 6px 0 12px rgba(0,0,0,0.6);
    border-radius: 1px 0 0 1px;
  }
  /* Türblatt: NUR die linke schlichte Scheibe -- das ist der tatsächliche
     Türflügel und schwingt am linken Scharnier nach innen auf. Die rechte
     Seite (Mittelsteg + Ausgabe-Box, siehe .door-static) ist fest montiertes
     Equipment und bewegt sich nicht mit. */
  .door-leaf {
    position: absolute;
    left: 0; width: 41.7%; top: 0; bottom: 0;
    z-index: 3;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.55s cubic-bezier(.4,0,.2,1);
  }
  .door-leaf.open {
    /* Schwingt mit echter Perspektive nach innen weg (freie Kante fährt in
       den Bus). Perspective als Funktion direkt in der transform-Kette
       (statt als separate Property auf .door-group) -- zuverlässiger, weil
       nicht von einem 3D-Rendering-Kontext eines Vorfahren abhängig. */
    transform: perspective(400px) rotateY(72deg);
  }
  /* Rahmenfarbe + dünner Outline wie im Original-Artwork: ein warmer
     Grau-Braun-Ton (nicht Schwarz) mit einer feinen dunklen Kontur, im
     selben Comic-Stil wie der Rest des Busses. */
  .door-frame-left {
    position: absolute;
    left: 0; width: 19.9%; top: 0; bottom: 0;
    background: #4f4547;
    border: 1px solid #171213;
  }
  .door-pane-left {
    position: absolute;
    left: 19.9%; right: 0; top: 0; bottom: 0;
    background: #28303e;
    border: 1px solid #171213;
    border-radius: 3px 3px 0 0;
  }

  /* Rechte Seite: bleibt immer an Ort und Stelle. */
  .door-static {
    position: absolute;
    left: 41.7%; width: 58.3%; top: 0; bottom: 0;
    z-index: 2;
  }
  .door-frame-right {
    position: absolute;
    right: 0; width: 7.2%; top: 0; bottom: 0;
    background: #4f4547;
    border: 1px solid #171213;
  }
  .door-mullion {
    position: absolute;
    left: 0; width: 28.5%; top: 0; bottom: 0;
    background: #4f4547;
    border: 1px solid #171213;
  }
  .door-pane-right {
    position: absolute;
    left: 28.5%; width: 64.3%; top: 0; bottom: 0;
    background: #4f4547;
    border: 1px solid #171213;
  }
  .door-glass {
    position: absolute;
    left: 6%; right: 6%; top: 0; height: 39.4%;
    background: #313a49;
    border-radius: 4px 4px 0 0;
  }
  .door-ledge {
    position: absolute;
    left: 6%; right: 6%; top: 39.4%; height: 15.5%;
    background: #b0aebb;
  }
  /* Kabinentür der Ausgabe-Box: deutlich gerundete Oberkante, wie im
     Original ein kleines Hatch/Klapptür-Element statt einer schlichten
     Ecke. */
  .door-panel {
    position: absolute;
    left: 6%; right: 6%; top: 57.1%; bottom: 11.9%;
    background: #5a4345;
    border-radius: 45% 45% 3px 3px;
  }
  .door-vent-light {
    position: absolute;
    left: 18%; top: 8%; width: 44%; height: 34%;
    background: #b6b4ba;
  }
  .door-vent-dark {
    position: absolute;
    left: 44%; top: 55%; width: 34%; height: 30%;
    background: #171213;
  }

  .wheel-well {
    position: absolute;
    width: 10.8%;
    height: 22.5%;
    top: 57.5%;
    background: #2b2b29;
    border-radius: 50% 50% 3px 3px;
  }
  .well-front { left: 23.15%; }
  .well-back  { left: 66.75%; }

  .wheel {
    position: absolute;
    width: 10.5%;
    top: 58%;
  }
  .wheel img { width: 100%; height: auto; display: block; }
  .wheel-front { left: 23.45%; }
  .wheel-back  { left: 67.05%; }

  .bus-wrap.arrived {
    left: 15%;
    transition: left 2.8s cubic-bezier(.25,.7,.3,1);
  }
  /* Push-in Richtung Tür: skaliert die GANZE Szene (Himmel, Strand, Bus --
     siehe .loader-scene) von der Tür aus, statt nur den Bus isoliert zu
     vergrößern. So wächst nicht "der Bus auf einen zu", sondern die
     gesamte Umgebung zieht am Betrachter vorbei -- fühlt sich an wie eine
     echte Vorwärtsbewegung auf die Tür zu. transform-origin sitzt exakt auf
     der Tür (--door-x/--door-y, per JS aus der echten Türposition gesetzt),
     damit die Tür selbst beim Skalieren bildfest bleibt. Läuft bewusst
     länger als der Moment, bis das Dunkel-Portal startet (siehe
     runSequence()), damit der Zoom erst eine Weile sichtbar ist, BEVOR der
     saubere Dunkel-Übergang übernimmt -- sonst wirkt es nicht wie ein
     echtes Reingehen. */
  .loader-scene.zoom {
    transform: scale(4.2);
    transition: transform 1.7s cubic-bezier(.4,0,.2,1);
  }

  /* Mobile: Der Bus soll nicht komplett auf den Screen passen, sondern die
     Bildhöhe nahezu ausfüllen (~70vh) und dabei breiter als der Viewport
     sein -> er fährt sichtbar durchs Bild (mit overflow:hidden am Loader
     gecroppt) statt komplett stehend anzukommen. Breite in vh statt % einer
     Breiten-Basis, damit die Höhe unabhängig vom Geräte-Seitenverhältnis
     immer ~70vh bleibt (Bus-Bild-Seitenverhältnis 1400:472 ≈ 2.966:1,
     70vh * 2.966 ≈ 208vh Breite). Die Zielposition beim Ankommen wird per
     calc() aus vw UND vh berechnet, damit die Tür (37.25% der Busbreite,
     selber Wert wie transform-origin) unabhängig vom Geräte-Seitenverhältnis
     mittig im Screen landet, bevor gezoomt wird. */
  @media (max-width: 640px) {
    .bus-wrap {
      width: 208vh;
      max-width: none;
      left: -230vh;
      /* + env(safe-area-inset-bottom): hebt den Bus aus dem Bereich der
         unteren Safari-Leiste/Home-Indicator heraus, im selben Maß, wie
         .loader-beach oben mitwächst. */
      bottom: calc(12vh + env(safe-area-inset-bottom, 0px));
    }
    .bus-wrap.arrived { left: calc(50vw - 77.48vh); }
  }

  /* Dunkel-Portal: reiner CSS-Gradient statt Raster-Zoom -> bleibt bei
     jeder Größe scharf. Startet unsichtbar (clip-path-Kreis mit Radius 0)
     exakt in der Türmitte (--door-x/--door-y werden per JS aus der
     tatsächlichen Türposition gesetzt, siehe runSequence()) und wächst beim
     Öffnen auf 150% Radius -> deckt den Screen unabhängig vom
     Seitenverhältnis komplett ab, bevor der Willkommens-Screen erscheint. */
  .entry-void {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    background: radial-gradient(circle at var(--door-x, 40%) var(--door-y, 55%),
                #12222f 0%, var(--ocean-deep) 55%, #06121c 100%);
    clip-path: circle(0% at var(--door-x, 40%) var(--door-y, 55%));
  }
  .bus-loader.entering .entry-void {
    clip-path: circle(150% at var(--door-x, 40%) var(--door-y, 55%));
    transition: clip-path 1.1s cubic-bezier(.4, 0, .2, 1);
  }

  .loader-welcome {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    text-align: center;
    /* Safe-Area-Puffer oben/unten: hält "Willkommen bei" + Logo auf sehr
       kurzen/breiten Viewports (z.B. iPhone quer) von den transparenten
       Safari-Leisten fern -- der Screen ist ohnehin flex-zentriert, das
       Padding wirkt nur als Mindestabstand zu den Rändern. */
    padding: calc(env(safe-area-inset-top, 0px) + 1rem) 1.5rem calc(env(safe-area-inset-bottom, 0px) + 1rem);
    opacity: 0;
    /* Startet leicht verschoben/verkleinert -- ein reines Opacity-Fade
       wirkte zu abrupt, die kleine Bewegung macht das Einblenden weicher. */
    transform: translateY(14px) scale(0.98);
  }
  .loader-welcome h1 {
    font-family: 'Darwin ALT', 'Darwin ALT Fallback', sans-serif;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 900;
    letter-spacing: -0.01em;
    color: var(--foam);
    margin: 0;
  }
  /* Gleiche weiße Pillen-Badge wie das Logo im Seiten-Footer (Kontakt.astro),
     damit der Übergang vom Intro zur restlichen Seite stimmig wirkt. */
  .loader-logo-badge {
    background: var(--foam);
    border-radius: var(--radius);
    padding: 10px 24px;
    display: inline-flex;
    align-items: center;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
  }
  .loader-logo-img {
    height: clamp(40px, 8vw, 56px);
    width: auto;
    object-fit: contain;
    display: block;
  }
  .loader-welcome.visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  /* Slide-out: der ganze Screen (Hintergrund + Willkommens-Text zusammen)
     fährt nach oben raus, während gleichzeitig main von unten reinfährt
     (siehe html.intro-reveal in global.css) -> Push-Übergang statt Fade. */
  .bus-loader.slide-out {
    transform: translateY(-100%);
    transition: transform 0.9s cubic-bezier(.4, 0, .2, 1);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bus-wrap, .loader-scene.zoom, .bus-loader.slide-out, .loader-welcome.visible,
    .door-leaf, .bus-suspension.settle, .dust-puff.puff,
    .bus-shadow.shadow-settle, .dust-trail span,
    .loader-sun, .loader-cloud, .loader-gull, .loader-gull .gull-wing, .loader-foam-line::after,
    .bus-loader.atmosphere-hidden .loader-sun,
    .bus-loader.atmosphere-hidden .loader-cloud,
    .bus-loader.atmosphere-hidden .loader-gull,
    .bus-loader.atmosphere-hidden .loader-foam-line,
    .entry-void, .bus-loader.entering .entry-void {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const html = document.documentElement;

  // Wenn der Loader gar nicht aktiviert wurde (kein intro-pending gesetzt:
  // schon gesehen / reduced-motion / slow-2g), sofort aufräumen und raus.
  if (!html.classList.contains('intro-pending')) {
    document.getElementById('bus-loader')?.remove();
  } else {
    html.classList.remove('intro-pending');

    // Scroll-Lock per JS (touchmove/wheel preventDefault) statt CSS
    // overflow:hidden auf <html>/<body> -- die Seite bleibt so technisch
    // scrollbar, nur die tatsächliche Nutzer-Scroll-Geste wird abgefangen.
    function preventScroll(e: Event) { e.preventDefault(); }
    function lockScroll() {
      window.addEventListener('touchmove', preventScroll, { passive: false });
      window.addEventListener('wheel', preventScroll, { passive: false });
    }
    function unlockScroll() {
      window.removeEventListener('touchmove', preventScroll);
      window.removeEventListener('wheel', preventScroll);
    }
    lockScroll();

    const loader = document.getElementById('bus-loader');
    const loaderScene = document.getElementById('loaderScene');
    const busWrap = document.getElementById('loaderBusWrap');
    const suspension = document.getElementById('loaderSuspension');
    const wheelFront = document.getElementById('loaderWheelFront');
    const wheelBack = document.getElementById('loaderWheelBack');
    const wheelFrontImg = wheelFront?.querySelector('img') as HTMLElement | null;
    const wheelBackImg = wheelBack?.querySelector('img') as HTMLElement | null;
    const welcome = document.getElementById('loaderWelcome');
    const dust = document.getElementById('loaderDust');
    const doorLeaf = document.getElementById('loaderDoorLeaf');
    const doorInterior = document.getElementById('loaderDoorInterior');
    const entryVoid = document.getElementById('loaderEntryVoid');
    const busShadow = document.getElementById('loaderBusShadow');

    let rafId: number | null = null;
    let totalRotation = 0;

    // Die Wheel-Assets (240x240) haben einen transparenten Rand um den Reifen;
    // der sichtbare Reifen füllt nur ~92% der Bildbreite. Ohne diese Korrektur
    // würde der berechnete Radumfang zu groß ausfallen und das Rad beim
    // Abrollen sichtbar rutschen statt physikalisch korrekt zu drehen.
    const WHEEL_TIRE_FILL_RATIO = 0.9208;

    function wait(ms: number) {
      return new Promise<void>((resolve) => setTimeout(resolve, ms));
    }

    function finishIntro() {
      try { sessionStorage.setItem('baf_intro_played', '1'); } catch (e) {}
      unlockScroll();
      html.classList.remove('intro-active');
      loader?.classList.add('slide-out');
      html.classList.add('intro-reveal');
      setTimeout(() => {
        loader?.remove();
        html.classList.remove('intro-loading', 'intro-reveal');
      }, 950);
    }

    function trackWheelRotation(onDone: () => void) {
      if (!busWrap || !wheelFrontImg || !wheelBackImg) return;
      const wheelRadiusPx = (wheelFrontImg.getBoundingClientRect().width * WHEEL_TIRE_FILL_RATIO) / 2;
      const circumference = 2 * Math.PI * wheelRadiusPx;
      const degPerPx = 360 / circumference;

      let lastX = busWrap.getBoundingClientRect().left;
      let hasMoved = false;
      let stillFrames = 0;

      function tick() {
        const currentX = busWrap!.getBoundingClientRect().left;
        const deltaX = currentX - lastX;
        lastX = currentX;

        if (Math.abs(deltaX) > 0.02) {
          hasMoved = true;
          stillFrames = 0;
          totalRotation += deltaX * degPerPx;
          const t = `rotate(${totalRotation}deg)`;
          wheelFrontImg!.style.transform = t;
          wheelBackImg!.style.transform = t;
          // Dezenter Speed-Blur: proportional zur aktuellen Bildschirm-
          // geschwindigkeit, klingt zum Stopp hin von selbst aus.
          const blurPx = Math.min(2.2, Math.abs(deltaX) * 0.15);
          busWrap!.style.filter = blurPx > 0.05 ? `blur(${blurPx}px)` : 'none';
        } else if (hasMoved) {
          stillFrames++;
        }

        if (hasMoved && stillFrames > 4) {
          busWrap!.style.filter = 'none';
          onDone();
          return;
        }
        rafId = requestAnimationFrame(tick);
      }
      rafId = requestAnimationFrame(tick);
    }

    async function runSequence() {
      if (!busWrap || !loaderScene || !wheelFrontImg || !wheelBackImg || !suspension || !doorLeaf || !dust || !doorInterior || !entryVoid || !loader) {
        finishIntro();
        return;
      }

      requestAnimationFrame(() => {
        // "driving" läuft den Staubschweif, solange sich der Bus tatsächlich
        // bewegt -- exakt an die echte Fahrtstrecke gekoppelt statt an eine
        // geschätzte feste Dauer.
        setTimeout(() => busWrap.classList.add('arrived', 'driving'), 50);
      });

      // Wartet, bis die Räder (physikalisch getrackt) tatsächlich stillstehen.
      await new Promise<void>((resolve) => trackWheelRotation(resolve));
      busWrap.classList.remove('driving');

      // Einfedern beim Stopp + kurzer Staubwirbel am Hinterrad + der
      // Bodenschatten federt kurz mit.
      suspension.classList.add('settle');
      busShadow?.classList.add('shadow-settle');
      dust.classList.add('puff');
      await wait(350);
      suspension.classList.remove('settle');
      busShadow?.classList.remove('shadow-settle');

      // Kurzer Beat, bevor die Tür aufgeht.
      await wait(250);

      // Tür schwingt mit echter Perspektive nach innen auf (rotateY am
      // linken Scharnier) -> der dunkle Innenraum dahinter wird kurz
      // sichtbar, statt sofort wegzublenden.
      doorLeaf.classList.add('open');
      await wait(450);

      // Dunkel-Portal exakt aus der Türmitte aufgehen lassen: Position der
      // tatsächlichen Türöffnung (nicht der ganzen Türgruppe, die auch die
      // starre Ausgabe-Box enthält) in Viewport-% umrechnen und als
      // CSS-Variablen setzen -> funktioniert dadurch auf jeder
      // Viewport-Größe inkl. Mobile exakt.
      const doorRect = doorInterior.getBoundingClientRect();
      const doorX = ((doorRect.left + doorRect.width / 2) / window.innerWidth) * 100;
      const doorY = ((doorRect.top + doorRect.height * 0.5) / window.innerHeight) * 100;
      loader.style.setProperty('--door-x', `${doorX}%`);
      loader.style.setProperty('--door-y', `${doorY}%`);

      // Push-in Richtung Tür fürs Momentum (bleibt scharf, kein Raster-Zoom
      // mehr) -- skaliert die ganze Szene (.loaderScene), nicht nur den Bus,
      // damit es sich wie eine Vorwärtsbewegung des Betrachters anfühlt …
      loaderScene.classList.add('zoom');
      // … läuft erst eine Weile FÜR SICH, bevor das Dunkel-Portal startet --
      // sonst sieht man den Zoom kaum und das "Reingehen" kommt nicht
      // rüber. Erst wenn man das Reinfahren auf die Tür schon spürt, holt
      // das Portal den Rest der Strecke.
      await wait(600);
      loader.classList.add('entering');
      loader.classList.add('atmosphere-hidden');
      // … Portal hat den Screen gefüllt (1.1s) -> Willkommens-Screen
      // blendet auf sauberem dunklem Grund ein.
      await wait(1100);
      welcome?.classList.add('visible');

      // Bleibt ~1.5s stehen, dann fährt der ganze Screen (Text + Hintergrund
      // zusammen) nach oben raus, während main gleichzeitig von unten
      // reinfährt (html.intro-reveal, siehe global.css) -> Push-Übergang
      // direkt in die Speisekarte statt Fade.
      await wait(1500);
      unlockScroll();
      html.classList.remove('intro-active');
      try { sessionStorage.setItem('baf_intro_played', '1'); } catch (e) {}
      loader?.classList.add('slide-out');
      html.classList.add('intro-reveal');

      // intro-loading (steuert display:block) erst HIER entfernen, nachdem
      // die Transform-Transition (0.9s) tatsächlich abgelaufen ist -> sonst
      // würde der Loader vorher per display:none hart verschwinden.
      await wait(950);
      loader?.remove();
      html.classList.remove('intro-loading', 'intro-reveal');
    }

    runSequence();
  }
</script>
