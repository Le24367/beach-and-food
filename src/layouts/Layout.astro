---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import '../styles/global.css'

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Beach and Food – Foodtruck 2.0 am Sütel-Strand',
  description = 'Fischbrötchen, Currywurst, Pommes und kalte Drinks – direkt am Sütel-Strand auf dem Campingplatz Sütel. Bei exakt 167°C, täglich frisch.'
} = Astro.props;

const canonicalUrl = 'https://beachandfood.de';
const ogImage = 'https://beachandfood.de/og-image.jpg';

// JSON-LD: LocalBusiness + FoodEstablishment
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["FoodEstablishment", "LocalBusiness"],
  "name": "Beach and Food",
  "description": description,
  "url": canonicalUrl,
  "logo": `${canonicalUrl}/logo/logo.jpeg`,
  "image": ogImage,
  "telephone": "+4915164652760",
  "email": "info@beachandfood.de",
  "priceRange": "€",
  "servesCuisine": ["Fischbrötchen", "Currywurst", "Fast Food"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Sütel Strand",
    "addressLocality": "Neukirchen",
    "postalCode": "23779",
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 54.337045,
    "longitude": 11.071475
  },
  "sameAs": [
    "https://www.instagram.com/beachandfood"
  ]
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- ── PWA ──────────────────────────────────────────────────────── -->
  <link rel="manifest" href="/manifest.json" />

  <!-- Theme-Color: Adressleiste auf Android / Chrome färben -->
  <meta name="theme-color" content="#1A3A4A" />

  <!-- iOS / Safari: App-fähig machen -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Beach & Food" />

  <!-- iOS App-Icons (Safari liest manifest.json nicht, braucht eigene Tags) -->
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />

  <!-- Microsoft Tiles (Windows / Edge) -->
  <meta name="msapplication-TileColor" content="#0D2233" />
  <meta name="msapplication-TileImage" content="/icons/icon-192.png" />
  <!-- ── Ende PWA ───────────────────────────────────────────────── -->

  <!-- LCP Preload: Logo (WebP, 1× Navbar) wird als erstes sichtbares Bild vorgeladen -->
  <link rel="preload" as="image" href="/logo/logo-300w.webp" type="image/webp" fetchpriority="high" />

  <!--
    Font Preload: Die zwei am häufigsten genutzten Weights werden sofort
    angefordert — parallel zum CSS statt sequenziell danach.
    Dadurch verkürzt sich die kritische Pfad-Kette um ~200-400 ms.

    WICHTIG: Diese Pfade müssen nach einem neuen Build geprüft werden —
    Astro fügt einen Content-Hash in den Dateinamen ein (z.B. dm-sans-latin-400-normal.CW0RaeGs.woff2).
    Den aktuellen Pfad findet man in den Browser-DevTools unter Network → Font.
    Alternativ: `ls dist/_astro/*.woff2` nach dem Build.

    Sobald die Hashes bekannt sind, diese Zeilen ersetzen:
  -->
  <!--
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="/_astro/dm-sans-latin-400-normal.HASH.woff2" />
  <link rel="preload" as="font" type="font/woff2" crossorigin
    href="/_astro/playfair-display-latin-700-normal.HASH.woff2" />
  -->

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Beach and Food" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD Strukturierte Daten -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />
  <Analytics />
  <SpeedInsights />
  <script>
    // ── Scroll reveal ────────────────────────────────────────────────
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // ── Service Worker registrieren ──────────────────────────────────
    // Nur in Produktion und wenn der Browser SW unterstützt.
    // Astro bündelt diesen Block bereits in das finale JS.
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker
          .register('/sw.js', { scope: '/' })
          .then((reg) => {
            console.log('[SW] registriert:', reg.scope);
          })
          .catch((err) => {
            console.warn('[SW] Registrierung fehlgeschlagen:', err);
          });
      });
    }
  </script>
</body>
</html>