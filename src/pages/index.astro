---
import Layout from '../layouts/Layout.astro';
import BusLoader from '../components/BusLoader.astro';
import Navbar from '../components/Navbar.astro';
import Angebot from '../components/Angebot.astro';
import Bestellen from '../components/Bestellen.astro';
import UeberUns from '../components/UeberUns.astro';
import Kontakt from '../components/Kontakt.astro';

// Reihenfolge: BusLoader (Vollbild-Splash mit Willkommens-Screen, sperrt
// Scroll) → Speisekarte → Bestellen → Über uns → Kontakt.
// Der Willkommensgruß lebt im BusLoader selbst (Fade-in, dann Slide-out) —
// danach ist direkt die Speisekarte da, keine eigene Hero-Sektion mehr im
// Seitenfluss nötig.
// BusLoader steht bewusst vor Navbar/main, damit er als erstes Element
// paint't und die Navbar (fixed, z-index 100) zuverlässig überdeckt.
---

<Layout>
  <BusLoader />
  <Navbar />
  <!-- #page-reveal (nicht main direkt) trägt die Einflug-Animation beim
       Bus-Loader-Übergang (siehe global.css, html.intro-loading). -->
  <div id="page-reveal">
    <main>
      <!-- Persistente, visuell versteckte h1: sichtbare Sektionen nutzen alle
           <h2>, die einzige <h1> im BusLoader wird nach dem Intro entfernt.
           Für SEO & Dokument-Outline braucht die Seite dauerhaft eine h1. -->
      <h1 class="sr-only">Beach and Food – Foodtruck 2.0 am Sütel-Strand</h1>
      <Angebot />
      <Bestellen />
      <UeberUns />
      <Kontakt />
    </main>
  </div>
</Layout>