---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Angebot from '../components/Angebot.astro';
import Bestellen from '../components/Bestellen.astro';
import UeberUns from '../components/UeberUns.astro';
import Kontakt from '../components/Kontakt.astro';

// Reihenfolge: Hero → Speisekarte → Bestellen → Über uns → Kontakt
// Nutzer werden nach dem Stöbern direkt zum Bestellen geführt
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Angebot />
    <Bestellen />
    <UeberUns />
    <Kontakt />
  </main>
</Layout>