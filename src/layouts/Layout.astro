---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import '../styles/global.css'
import { getSiteSettings } from '../lib/sanity'
import { CONTACT, SITE } from '../lib/config'

export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Beach and Food – Foodtruck 2.0 am Sütel-Strand',
  description = 'Fischbrötchen, Currywurst, Pommes und kalte Drinks – direkt am Sütel-Strand auf dem Campingplatz Sütel. Bei exakt 167°C, täglich frisch.'
} = Astro.props;

// Kontaktdaten für JSON-LD: Sanity hat Vorrang, config.ts als Fallback
const settings = await getSiteSettings().catch(() => null)
const telephone = settings?.contact?.telephone ?? CONTACT.telephone
const email     = settings?.contact?.email     ?? CONTACT.email

// Adresse für JSON-LD: Sanity hat Vorrang, damit eine Adressänderung im CMS
// auch in den strukturierten Daten (Google-Suchergebnisse) ankommt, ohne
// dass jemand Code anfassen muss.
const addr = settings?.address
const streetAddress   = addr?.street ?? 'Sütel Strand'
const addressLocality  = addr?.zip?.replace(/^\d+\s*/, '') || 'Neukirchen'
const postalCodeMatch  = addr?.zip?.match(/^\d+/)
const postalCode       = postalCodeMatch?.[0] ?? '23779'

// FIX: canonicalUrl zeigte bisher immer auf SITE.url (die Startseite) --
// auf /impressum, /datenschutz und der 404-Seite stand dadurch derselbe
// canonical-Link wie auf der Startseite im <head>, was Google als
// "diese Seiten sind Duplikate der Startseite" liest. Jetzt aus dem
// tatsächlichen Pfad abgeleitet; SITE.url bleibt separat für JSON-LD
// (dort ist die Domain-Wurzel, nicht die Unterseite, korrekt).
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString()
const ogImage = `${SITE.url}/og-image.jpg`

// Öffnungszeiten für JSON-LD: dieselbe Quelle wie Kontakt.astro (Sanity mit
// Vorrang, sonst derselbe Fallback), damit sich beide nie widersprechen.
const openingHours = settings?.openingHours ?? [
  { _key: 'mo-do', days: 'Mo – Do', hours: 'Geschlossen', closed: true },
  { _key: 'fr-so', days: 'Fr – So', hours: '11:30 – 20:00', closed: false },
]

// "Mo – Do" / "Fr – So" -> ['Monday', ..., 'Thursday'] etc. Die Reihenfolge
// hier ist zugleich die Woche selbst -- ein Bereich wird als Ausschnitt
// daraus gelesen, kein Wrap-around nötig, da "So" (Sonntag) immer das Ende
// der Liste ist.
//
// Das "days"-Feld ist Freitext im Sanity-Studio -- die echten Werte weichen
// vom hier hinterlegten Fallback ab (z.B. "Montag-Sonntag" statt "Mo – So").
// DAY_ALIASES deckt deshalb sowohl Abkürzungen als auch ausgeschriebene
// deutsche Tagesnamen ab, case-insensitiv.
const DAY_ORDER = ['Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So'] as const
const DAY_NAMES: Record<string, string> = {
  Mo: 'Monday', Di: 'Tuesday', Mi: 'Wednesday', Do: 'Thursday',
  Fr: 'Friday', Sa: 'Saturday', So: 'Sunday',
}
const DAY_ALIASES: Record<string, typeof DAY_ORDER[number]> = {
  mo: 'Mo', montag: 'Mo',
  di: 'Di', dienstag: 'Di',
  mi: 'Mi', mittwoch: 'Mi',
  do: 'Do', donnerstag: 'Do',
  fr: 'Fr', freitag: 'Fr',
  sa: 'Sa', samstag: 'Sa', sonnabend: 'Sa',
  so: 'So', sonntag: 'So',
}

// Erlaubt außerdem kommagetrennte Listen aus Einzeltagen/Bereichen
// ("Fr, Sa, So"), falls das im Studio irgendwann so eingetragen wird.
function parseDayRange(days: string): string[] {
  const result: string[] = []
  for (const segment of days.split(',')) {
    const tokens = segment.split(/[–—-]/).map((s) => DAY_ALIASES[s.trim().toLowerCase()]).filter(Boolean)
    if (tokens.length === 1) {
      result.push(DAY_NAMES[tokens[0]])
    } else if (tokens.length === 2) {
      const startIdx = DAY_ORDER.indexOf(tokens[0])
      const endIdx = DAY_ORDER.indexOf(tokens[1])
      if (startIdx !== -1 && endIdx >= startIdx) {
        result.push(...DAY_ORDER.slice(startIdx, endIdx + 1).map((d) => DAY_NAMES[d]))
      }
    }
  }
  return [...new Set(result)]
}

function parseHourRange(hours: string): { opens: string; closes: string } | null {
  const match = hours.match(/(\d{1,2}[:.]\d{2})\s*[–-]\s*(\d{1,2}[:.]\d{2})/)
  if (!match) return null
  return { opens: match[1].replace('.', ':'), closes: match[2].replace('.', ':') }
}

// Google zeigt ein "Jetzt geöffnet"/"Geschlossen"-Badge im Suchergebnis nur,
// wenn openingHoursSpecification vorhanden ist -- geschlossene Tage werden
// hier bewusst weggelassen (die Spezifikation beschreibt NUR Öffnungszeiten,
// nicht ihr Gegenteil).
const openingHoursSpecification = openingHours.flatMap((entry) => {
  if (entry.closed) return []
  const dayOfWeek = parseDayRange(entry.days)
  const time = parseHourRange(entry.hours)
  if (dayOfWeek.length === 0 || !time) return []
  return [{
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": dayOfWeek,
    "opens": time.opens,
    "closes": time.closes,
  }]
})

// JSON-LD: LocalBusiness + FoodEstablishment
const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["FoodEstablishment", "LocalBusiness"],
  "name": "Beach and Food",
  "description": description,
  "url": SITE.url,
  "logo": `${SITE.url}/logo/logo.jpeg`,
  "image": ogImage,
  "telephone": telephone,
  "email": email,
  "priceRange": "€",
  "servesCuisine": ["Fischbrötchen", "Currywurst", "Fast Food"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": streetAddress,
    "addressLocality": addressLocality,
    "postalCode": postalCode,
    "addressCountry": "DE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 54.337045,
    "longitude": 11.071475
  },
  ...(openingHoursSpecification.length > 0 ? { openingHoursSpecification } : {}),
  "sameAs": [
    "https://www.instagram.com/beachandfood"
  ]
};
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <!--
    FIX: user-scalable=no entfernt (WCAG 1.4.4 — Pinch-to-Zoom darf nicht
    verhindert werden). maximum-scale bleibt bei 5, ein üblicher, unauffälliger
    Wert, der trotzdem echtes Zoomen für sehbeeinträchtigte Nutzer erlaubt.
  -->
  <!-- viewport-fit=cover: lässt fixed-position-Overlays (z.B. der BusLoader)
       auf iOS bis unter die transparenten Safari-Leisten (oben/unten) reichen,
       statt an deren Kante abrupt abzuschneiden. Aktiviert außerdem
       env(safe-area-inset-*), das der BusLoader nutzt, um Bus/Text aus dem
       Bereich der Leisten herauszuhalten, während der Hintergrund weiter bis
       zum Bildschirmrand durchläuft. -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- ── PWA ──────────────────────────────────────────────────────── -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1A3A4A" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Beach & Food" />
  <link rel="apple-touch-icon" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512.png" />
  <meta name="msapplication-TileColor" content="#0D2233" />
  <meta name="msapplication-TileImage" content="/icons/icon-192.png" />
  <!-- ── Ende PWA ───────────────────────────────────────────────── -->

  <!--
    Logo früh laden — erstes sichtbares Bild in der Navbar.
    Fonts laufen über global.css mit font-display: swap — kein preload-Link
    nötig, da @fontsource beim Build einen Hash in den Dateinamen einfügt
    und ein hardcodierter Pfad immer 404 erzeugen würde.
  -->
  <link rel="preload" as="image" href="/logo/logo-300w.webp" type="image/webp" fetchpriority="high" />

  <!-- Open Graph / WhatsApp / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Beach and Food – Foodtruck am Sütel-Strand" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Beach and Food" />

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="Beach and Food – Foodtruck am Sütel-Strand" />

  <!-- JSON-LD Strukturierte Daten -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <slot />
  <Analytics />
  <SpeedInsights />
  <script>
    // ── Scroll Reveal ────────────────────────────────────────────────
    //
    // requestAnimationFrame-Wrap: Der Browser hat zum Zeitpunkt des
    // Script-Ausführens den ersten Paint noch nicht abgeschlossen.
    // Ohne rAF bekommen Elemente, die beim Laden bereits im Viewport
    // liegen, die .visible-Klasse bevor der Browser sie gerendert hat
    // → ein Frame lang unsichtbar → sichtbares Buckeln.
    // Mit rAF wartet der Observer bis nach dem ersten Paint.
    //
    // rootMargin: '-48px' unten → Element muss 48px in den Viewport
    // hineinragen bevor es eingeblendet wird. Verhindert dass Elemente
    // am unteren Rand halb-sichtbar einpoppen.
    //
    // unobserve() nach dem ersten Trigger: danach ist die Animation
    // abgespielt, das Element muss nie wieder beobachtet werden.

    requestAnimationFrame(() => {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.08,
          rootMargin: '0px 0px -80px 0px',
        }
      );

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    });

    // ── Service Worker registrieren ──────────────────────────────────
    // NUR in Produktion: sw.js liefert HTML/JS/CSS per stale-while-revalidate
    // aus (siehe public/sw.js) — im Dev-Server (npm run dev) würde das jede
    // Code-Änderung erst nach dem ÜBERNÄCHSTEN Reload sichtbar machen (Cache
    // wird nur im Hintergrund fürs nächste Mal aktualisiert). Das hat in der
    // Entwicklung wiederholt zu "Änderungen kommen nicht an"/"startet nicht"
    // geführt. import.meta.env.DEV ist im Dev-Server true, im Build false.
    // Zusätzlich: falls im Dev-Server bereits ein SW aus einer früheren
    // Produktions-Vorschau registriert ist, hier automatisch entfernen.
    if ('serviceWorker' in navigator) {
      if (import.meta.env.DEV) {
        navigator.serviceWorker.getRegistrations().then((regs) => {
          regs.forEach((r) => r.unregister());
        });
      } else {
        // Kein Erfolgs-Log mehr in Produktion — nur eine Warnung, falls die
        // Registrierung fehlschlägt (hilfreich für Support-Anfragen des Kunden).
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js', { scope: '/' })
            .catch((err) => {
              console.warn('[SW] Registrierung fehlgeschlagen:', err);
            });
        });
      }
    }
  </script>
</body>
</html>
