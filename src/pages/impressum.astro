---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import { getLegal, getSiteSettings } from '../lib/sanity'
import { CONTACT } from '../lib/config'

const legal = await getLegal()
const settings = await getSiteSettings().catch(() => null)

const email     = settings?.contact?.email     ?? CONTACT.email
const telephone = settings?.contact?.telephone ?? CONTACT.telephone
---

<Layout
  title="Impressum – Beach and Food"
  description="Impressum gemäß § 5 DDG von Beach and Food."
>
  <Navbar />
  <main class="legal-page">
    <div class="container">
      <a href="/" class="back-link">← Zurück zur Startseite</a>
      <h1>Impressum</h1>
      <p class="legal-sub">Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG)</p>

      <section>
        <h2>Anbieter</h2>
        <p>
          {legal.companyName}<br />
          {legal.address}
        </p>
      </section>

      <section>
        <h2>Vertreten durch</h2>
        <p>{legal.managingDirector}</p>
      </section>

      <section>
        <h2>Kontakt</h2>
        <p>
          Telefon: <a href={`tel:${telephone}`}>{telephone}</a><br />
          E-Mail: <a href={`mailto:${email}`}>{email}</a>
        </p>
      </section>

      <section>
        <h2>Registereintrag</h2>
        <p>
          Eintragung im Handelsregister.<br />
          Registergericht: {legal.registerCourt}<br />
          Registernummer: {legal.registerNumber}
        </p>
      </section>

      <section>
        <h2>Umsatzsteuer-ID</h2>
        <p>
          Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz:<br />
          {legal.vatId}
        </p>
      </section>

      <section>
        <h2>Verantwortlich für den Inhalt</h2>
        <p>
          {legal.managingDirector}<br />
          {legal.address}
        </p>
      </section>

      <section>
        <h2>EU-Streitschlichtung</h2>
        <p>
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
          <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer">
            https://ec.europa.eu/consumers/odr/
          </a>.
          Unsere E-Mail-Adresse finden Sie oben unter „Kontakt“.
        </p>
      </section>

      <section>
        <h2>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h2>
        <p>
          Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer
          Verbraucherschlichtungsstelle teilzunehmen.
        </p>
      </section>

      <p class="legal-note">
        ⚠️ Hinweis für den Betreiber: Bitte prüfen Sie alle oben genannten Angaben
        (Firma, Geschäftsführung, Registergericht, Handelsregisternummer, USt-IdNr.)
        auf Richtigkeit und Vollständigkeit, bevor die Seite live geht. Diese Werte
        lassen sich im Sanity-Studio unter „Einstellungen → Impressum &amp; Rechtliches“
        pflegen.
      </p>
    </div>
  </main>
</Layout>

<style>
.legal-page {
  padding: 9rem 0 6rem;
  background: var(--sand-light);
  min-height: 100vh;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--wave);
  margin-bottom: 2rem;
  transition: gap 0.2s ease, color 0.2s ease;
}
.back-link:hover {
  gap: 0.6rem;
  color: var(--coral);
}
.legal-page h1 {
  font-size: clamp(2.2rem, 5vw, 3rem);
  font-weight: 900;
  color: var(--ocean-deep);
  margin-bottom: 0.5rem;
}
.legal-sub {
  color: var(--text-muted);
  font-size: 0.95rem;
  margin-bottom: 2.5rem;
}
.legal-page section {
  margin-bottom: 2rem;
  max-width: 640px;
}
.legal-page h2 {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--ocean-deep);
  margin-bottom: 0.5rem;
}
.legal-page p {
  color: var(--text);
  line-height: 1.7;
  font-size: 0.95rem;
}
.legal-page a {
  color: var(--wave);
  text-decoration: underline;
  text-decoration-color: transparent;
  transition: text-decoration-color 0.2s;
}
.legal-page a:hover {
  text-decoration-color: var(--wave);
}
.legal-note {
  margin-top: 3rem;
  padding: 1rem 1.25rem;
  background: rgba(244, 168, 32, 0.12);
  border: 1px solid rgba(244, 168, 32, 0.35);
  border-radius: var(--radius);
  font-size: 0.85rem;
  color: var(--text-muted);
  max-width: 640px;
}
</style>
