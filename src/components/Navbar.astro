---
<nav class="navbar">
  <div class="container nav-inner">
    <a href="/" class="logo">
      <img
        src="https://le-cdn.website-editor.net/b027c68ee438471e875aabacd5abae82/dms3rep/multi/opt/Beach+-+Food+Final-1920w.jpg"
        alt="Beach and Food"
        class="logo-img"
      />
    </a>
    <ul class="nav-links">
      <li><a href="#angebot">Speisekarte</a></li>
      <li><a href="#vibes">Beach Vibes</a></li>
      <li><a href="#ueber-uns">Über uns</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
      <li><a href="https://www.bon-bon.de/gutschein/beach-and-food/?popup" target="_blank" rel="noopener">🎁 Gutschein</a></li>
    </ul>
    <a href="https://igetnow.com/KWFQC" target="_blank" rel="noopener" class="nav-cta">Jetzt bestellen</a>
    <button class="burger" aria-label="Menü öffnen">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu">
    <ul>
      <li><a href="#angebot">Speisekarte</a></li>
      <li><a href="#vibes">Beach Vibes</a></li>
      <li><a href="#ueber-uns">Über uns</a></li>
      <li><a href="#kontakt">Kontakt</a></li>
      <li><a href="https://www.bon-bon.de/gutschein/beach-and-food/?popup" target="_blank" rel="noopener">🎁 Gutschein</a></li>
      <li><a href="https://igetnow.com/KWFQC" target="_blank" rel="noopener" class="nav-cta-mobile">Jetzt bestellen</a></li>
    </ul>
  </div>
</nav>

<style>
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: #ffffff;
  border-bottom: 1px solid rgba(244, 168, 32, 0.25);
  box-shadow: 0 2px 16px rgba(0,0,0,0.06);
  border-radius: 0 0 20px 20px;
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding-top: 1rem;
  padding-bottom: 1rem;
}
.logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.logo-img {
  height: 44px;
  width: auto;
  object-fit: contain;
  display: block;
}
.nav-links {
  display: flex;
  list-style: none;
  gap: 2rem;
  margin-left: auto;
}
.nav-links a {
  font-size: 0.9rem;
  font-weight: 500;
  color: var(--ocean);
  transition: color 0.2s;
}
.nav-links a:hover { color: var(--sun-bright); }
.nav-cta {
  background: var(--sun);
  color: var(--ocean-deep);
  font-weight: 600;
  font-size: 0.85rem;
  padding: 0.55rem 1.2rem;
  border-radius: 100px;
  transition: background 0.2s, transform 0.15s;
  white-space: nowrap;
}
.nav-cta:hover {
  background: var(--coral);
  transform: scale(1.04);
}
.burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  margin-left: auto;
  padding: 4px;
}
.burger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--ocean);
  border-radius: 2px;
  transition: transform 0.3s, opacity 0.3s;
}
.mobile-menu {
  max-height: 0;
  overflow: hidden;
  background: var(--sand-light);
  transition: max-height 0.45s cubic-bezier(0.4, 0, 0.2, 1),
              opacity 0.35s ease;
  opacity: 0;
}
.mobile-menu.open {
  max-height: 500px;
  opacity: 1;
  border-radius: 0 0 20px 20px;
}
.mobile-menu ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0;
  padding: 0.5rem 1.5rem 1.5rem;
}
.mobile-menu li {
  border-bottom: 1px solid rgba(0,0,0,0.06);
  transform: translateY(-8px);
  opacity: 0;
  transition: transform 0.35s ease, opacity 0.35s ease;
}
.mobile-menu li:last-child { border-bottom: none; }
.mobile-menu.open li {
  transform: translateY(0);
  opacity: 1;
}
.mobile-menu.open li:nth-child(1) { transition-delay: 0.05s; }
.mobile-menu.open li:nth-child(2) { transition-delay: 0.10s; }
.mobile-menu.open li:nth-child(3) { transition-delay: 0.15s; }
.mobile-menu.open li:nth-child(4) { transition-delay: 0.20s; }
.mobile-menu.open li:nth-child(5) { transition-delay: 0.25s; }
.mobile-menu.open li:nth-child(6) { transition-delay: 0.30s; }
.mobile-menu a {
  display: block;
  font-size: 1.05rem;
  font-weight: 500;
  color: var(--ocean);
  padding: 0.9rem 0;
  transition: color 0.2s, padding-left 0.2s;
}
.mobile-menu a:hover {
  color: var(--sun);
  padding-left: 0.4rem;
}
.nav-cta-mobile {
  display: block;
  text-align: center;
  background: var(--sun);
  color: var(--ocean-deep) !important;
  font-weight: 600;
  padding: 0.75rem 1.4rem !important;
  border-radius: 100px;
  margin-top: 0.5rem;
  margin-bottom: 0.25rem;
}
/* Burger → X Animation */
.burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.burger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
@media (max-width: 1024px) {
  .nav-links, .nav-cta { display: none; }
  .burger { display: flex; }
}
</style>

<script>
  const burger = document.querySelector('.burger');
  const mobileMenu = document.querySelector('.mobile-menu');

  burger?.addEventListener('click', () => {
    burger.classList.toggle('open');
    mobileMenu?.classList.toggle('open');
    if (!mobileMenu?.classList.contains('open')) {
      mobileMenu?.querySelectorAll('li').forEach(li => {
        li.style.transitionDelay = '0s';
      });
    } else {
      mobileMenu?.querySelectorAll('li').forEach((li, i) => {
        li.style.transitionDelay = '';
      });
    }
  });

  mobileMenu?.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      burger?.classList.remove('open');
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1024) {
      mobileMenu?.classList.remove('open');
      burger?.classList.remove('open');
    }
  });
</script>