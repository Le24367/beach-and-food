  </div>
</section>

<section class="vibes" id="vibes">
  <div class="vibes-card">
    <div class="container">
      <div class="vibes-inner reveal">
        <span class="section-label" style="color: var(--sun)">Beach Vibes</span>
        <h2>Der Sound zum Strandtag.</h2>
        <p>Unser Song — gute Laune inklusive.</p>

        <div
          class="spotify-facade"
          data-embed-src={EMBED_URL}
          data-track-url={TRACK_URL}
          role="button"
          tabindex="0"
          aria-label={`${trackTitle} von ${trackArtist} auf Spotify abspielen`}
        >
          <div class="sp-preview">
            <div class="sp-cover-wrap">
              {trackCover
                ? <img class="sp-cover" src={trackCover} alt={`${trackTitle} Cover`} loading="lazy" width="80" height="80" />
                : <div class="sp-cover-fallback">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="#1DB954"><circle cx="12" cy="12" r="12" fill="#1DB954"/><path fill="white" d="M17.9 10.9C14.7 9 9.35 8.8 6.3 9.75c-.5.15-1-.15-1.15-.6-.15-.5.15-1 .6-1.15C9.65 6.8 15.45 7 19.1 9.15c.45.25.6.85.35 1.3-.25.35-.85.5-1.3.25M17.65 13.5c-.2.35-.6.45-.95.25-2.65-1.6-6.65-2.05-9.75-1.15-.35.1-.75-.1-.85-.45-.1-.35.1-.75.45-.85 3.55-1.05 7.95-.55 10.95 1.3.3.15.4.6.15.9M16.6 16.2c-.15.25-.5.35-.75.2-2.3-1.4-5.2-1.75-8.65-1-.3.1-.55-.15-.65-.4-.1-.3.15-.55.4-.65 3.75-.85 6.95-.5 9.5 1.1.3.15.35.5.15.75"/></svg>
                  </div>
              }
            </div>

            <div class="sp-info">
              <div class="sp-provider">
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1DB954"/><path fill="white" d="M17.9 10.9C14.7 9 9.35 8.8 6.3 9.75c-.5.15-1-.15-1.15-.6-.15-.5.15-1 .6-1.15C9.65 6.8 15.45 7 19.1 9.15c.45.25.6.85.35 1.3-.25.35-.85.5-1.3.25M17.65 13.5c-.2.35-.6.45-.95.25-2.65-1.6-6.65-2.05-9.75-1.15-.35.1-.75-.1-.85-.45-.1-.35.1-.75.45-.85 3.55-1.05 7.95-.55 10.95 1.3.3.15.4.6.15.9M16.6 16.2c-.15.25-.5.35-.75.2-2.3-1.4-5.2-1.75-8.65-1-.3.1-.55-.15-.65-.4-.1-.3.15-.55.4-.65 3.75-.85 6.95-.5 9.5 1.1.3.15.35.5.15.75"/></svg>
                Spotify
              </div>
              <p class="sp-title">{trackTitle}</p>
              <p class="sp-artist">{trackArtist}</p>
              <p class="sp-hint">▶ Klicken zum Abspielen</p>
            </div>

            <button class="sp-play-btn" aria-label="Song auf Spotify abspielen" tabindex="-1">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
                <circle cx="12" cy="12" r="12" fill="#1DB954"/>
                <polygon fill="white" points="9.5,7 18,12 9.5,17"/>
              </svg>
            </button>
          </div>

          <p class="sp-consent">
            Mit Klick wird eine Verbindung zu Spotify hergestellt.
            {/* aria-label unterscheidet diesen Link von den anderen "Datenschutz"-Links */}
            <a
              href="https://www.spotify.com/de/legal/privacy-policy/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Datenschutzerklärung von Spotify"
            >Datenschutz</a>
          </p>
        </div>

        <a
          href={TRACK_URL}
          target="_blank"
          rel="noopener"
          class="spotify-open-link"
          aria-label="Song in Spotify App öffnen"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#1DB954"/><path fill="white" d="M17.9 10.9C14.7 9 9.35 8.8 6.3 9.75c-.5.15-1-.15-1.15-.6-.15-.5.15-1 .6-1.15C9.65 6.8 15.45 7 19.1 9.15c.45.25.6.85.35 1.3-.25.35-.85.5-1.3.25M17.65 13.5c-.2.35-.6.45-.95.25-2.65-1.6-6.65-2.05-9.75-1.15-.35.1-.75-.1-.85-.45-.1-.35.1-.75.45-.85 3.55-1.05 7.95-.55 10.95 1.3.3.15.4.6.15.9M16.6 16.2c-.15.25-.5.35-.75.2-2.3-1.4-5.2-1.75-8.65-1-.3.1-.55-.15-.65-.4-.1-.3.15-.55.4-.65 3.75-.85 6.95-.5 9.5 1.1.3.15.35.5.15.75"/></svg>
          In Spotify App öffnen
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function initSpotifyFacade(facade: HTMLElement) {
    const activate = () => {
      const embedSrc = facade.dataset.embedSrc
      if (!embedSrc) return

      const iframe = document.createElement('iframe')
      iframe.src = embedSrc
      iframe.width = '100%'
      iframe.height = '152'
      iframe.title = 'Spotify Player'
      iframe.setAttribute('frameborder', '0')
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture'
      iframe.loading = 'lazy'
      iframe.style.borderRadius = '16px'
      iframe.style.display = 'block'
      iframe.style.width = '100%'

      facade.replaceWith(iframe)
    }

    facade.addEventListener('click', activate)
    facade.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault()
        activate()
      }
    })
  }

  const facade = document.querySelector<HTMLElement>('.spotify-facade')
  if (facade) initSpotifyFacade(facade)
</script>

