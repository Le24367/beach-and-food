---
import { getSiteSettings } from '../lib/sanity'
import slateTexture from '../assets/textures/slate-stone.webp'

const settings = await getSiteSettings().catch(() => null)

// YouTube-ID aus Sanity, Fallback auf hardcodierten Wert
const YT_ID = settings?.youtubeId ?? 'QuSgl1-ZICE'

// Thumbnail wird automatisch aus der ID abgeleitet —
// bei Änderung der ID in Sanity wird beim nächsten Build das richtige Bild geladen
const ytThumbnail = `https://i.ytimg.com/vi/${YT_ID}/hqdefault.jpg`

// Galerie-Bilder: jetzt mit srcset (sm + lg) für responsive Bildgrößen
interface GallerySlide {
  src: string
  srcset?: string
  sizes?: string
  alt: string
  caption: string | null
}

let sanitySlides: GallerySlide[] = [];
try {
  const raw = await import('../../src/generated/gallery-images.json', { assert: { type: 'json' } });
  sanitySlides = (raw.default ?? []) as GallerySlide[];
} catch {
  // Datei existiert noch nicht (erster Build vor fetch-images) → ignorieren
}

const slides: GallerySlide[] =
  sanitySlides.length > 0
    ? sanitySlides
    : [{ src: '/images/ueberuns/placeholder.jpg', alt: 'Beach and Food', caption: null }];
---
<section class="ueber-uns" id="ueber-uns">
  <div class="uu-card" style={`--slate-texture: url(${slateTexture.src})`}>
  <div class="container">

    <div class="uu-grid">
      <div class="uu-content reveal">
        <span class="section-label">Über uns</span>
        <h2>Vom kleinen Anhänger zum Foodtruck 2.0.</h2>
      </div>

      <div class="uu-image reveal" style="transition-delay:0.15s">
        <div class="carousel" id="uu-carousel">
          <div class="carousel-track" aria-live="polite" aria-atomic="true">
            {slides.map((slide, i) => (
              <div
                class={`carousel-slide${i === 0 ? ' active' : ''}`}
                aria-hidden={i !== 0 ? 'true' : 'false'}
              >
                <img
                  src={slide.src}
                  srcset={slide.srcset}
                  sizes={slide.sizes ?? '(max-width: 900px) 100vw, 50vw'}
                  alt={slide.alt}
                  width="860"
                  height="560"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding={i === 0 ? 'sync' : 'async'}
                />
                {slide.caption && (
                  <div class="carousel-caption">{slide.caption}</div>
                )}
              </div>
            ))}
          </div>

          {slides.length > 1 && (
            <>
              <button class="carousel-btn carousel-prev" aria-label="Vorheriges Bild">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              </button>
              <button class="carousel-btn carousel-next" aria-label="Nächstes Bild">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
              <div class="carousel-dots" id="uu-dots" role="tablist" aria-label="Bildauswahl"></div>
            </>
          )}
        </div>
      </div>
    </div>

    <!--
      Schlangen-Timeline: volle Breite, geschlängelter SVG-Pfad mit einer
      Kehre auf der rechten Seite. Zwei getrennte Markup-Varianten
      (Desktop-Schlange vs. Mobile-Vertikale), aber EIN gemeinsamer
      Scroll-Fortschritt treibt beide gleichzeitig an (initSnakeTimeline
      im Script unten) — nur die CSS-Sichtbarkeit wechselt per Breakpoint.
      pathLength="1" normiert die Pfadlänge, damit stroke-dashoffset direkt
      mit dem 0..1-Scroll-Fortschritt arbeiten kann (kein getTotalLength()).
    -->
    <div class="uu-timeline-snake reveal" id="uu-timeline" style="transition-delay:0.2s">
      <!--
        Pin-Wrapper: hoher Runway (Desktop only), damit .snake-desktop per
        position:sticky während des Scrollens stehen bleibt und die
        Zeichnen-Animation über eine deutlich längere Scroll-Strecke abläuft,
        statt im bisherigen kurzen 0.7-Viewport-Fenster (initSnakeTimeline im
        Script berechnet den Fortschritt bei Desktop-Breite jetzt aus diesem
        Wrapper statt aus der Bounding-Box von .snake-desktop selbst).
      -->
      <div class="snake-desktop-pin" id="snake-desktop-pin">
      <div class="snake-desktop" aria-hidden="true">
        <svg class="snake-svg" viewBox="0 0 1200 700" preserveAspectRatio="none">
          <path class="snake-track" d="M 60 110 C 246.7 103.3 450 78.3 620 90 C 790 101.7 990 145 1080 180 C 1170 215 1180 273.3 1160 300 C 1140 326.7 1060 328.3 960 340 C 860 351.7 670 360 560 370 C 450 380 368.3 390 300 400 C 231.7 410 181.7 420 150 430 C 118.3 440 120 448.3 110 460 C 100 471.7 83.3 483.3 90 500 C 96.7 516.7 106.7 541.7 150 560 C 193.3 578.3 275 596.7 350 610 C 425 623.3 558.3 625 600 640 C 641.7 655 600 680 600 700" />
          <path class="snake-draw" pathLength="1" d="M 60 110 C 246.7 103.3 450 78.3 620 90 C 790 101.7 990 145 1080 180 C 1170 215 1180 273.3 1160 300 C 1140 326.7 1060 328.3 960 340 C 860 351.7 670 360 560 370 C 450 380 368.3 390 300 400 C 231.7 410 181.7 420 150 430 C 118.3 440 120 448.3 110 460 C 100 471.7 83.3 483.3 90 500 C 96.7 516.7 106.7 541.7 150 560 C 193.3 578.3 275 596.7 350 610 C 425 623.3 558.3 625 600 640 C 641.7 655 600 680 600 700" />
        </svg>
        <!--
          Node-Position (data-snake-x/y, in SVG-Viewbox-Einheiten) UND der
          Scroll-Schwellenwert, ab dem der Node erscheint, werden beide zur
          Laufzeit aus der tatsächlichen Pfadgeometrie berechnet (siehe
          initSnakeTimeline im Script). Kein Hand-Errechnen von %-Werten
          mehr nötig, wenn sich der Pfad ändert.
        -->
        <div class="snake-node snake-node--left" data-snake-x="60" data-snake-y="110">
          <span class="snake-dot"></span>
          <div class="snake-card">
            <div class="snake-year">2014</div>
            <p class="snake-text"><strong>Die Anfänge.</strong> 2014 mit einem kleinen, geliehenen Imbissanhänger gestartet — die Qualität hat euch trotzdem überzeugt.</p>
          </div>
        </div>
        <div class="snake-node snake-node--left" data-snake-x="620" data-snake-y="90">
          <span class="snake-dot"></span>
          <div class="snake-card">
            <div class="snake-year">2015</div>
            <p class="snake-text"><strong>Neuer Wagen.</strong> Größer, ganz auf uns zugeschnitten — dazu neue Kreationen rund um Wurst und Pommes. Qualität und Frische blieben, wie sie waren.</p>
          </div>
        </div>
        <div class="snake-node snake-node--right" data-snake-x="1160" data-snake-y="300">
          <span class="snake-dot"></span>
          <div class="snake-card">
            <div class="snake-year">2020</div>
            <p class="snake-text"><strong>Der Bus kam dazu.</strong> Der Foodtruck 2.0 — ein umgebauter Linienbus, extra für uns gebaut — bringt seitdem einen Indoorbereich für die Schietwetter-Tage am Strand.</p>
          </div>
        </div>
        <div class="snake-node snake-node--left snake-node--current" data-snake-x="110" data-snake-y="460">
          <span class="snake-dot"></span>
          <div class="snake-card">
            <div class="snake-year">2024</div>
            <p class="snake-text"><strong>Digital angekommen.</strong> Bestellen und bezahlen per Handy, zwei Self-Order-Terminals, Abholnummern auf Bildschirmen und Bezahlen per QR-Code.</p>
          </div>
        </div>
      </div>
      </div>

      <div class="snake-mobile">
        <svg class="snake-svg-mobile" viewBox="0 0 60 620" preserveAspectRatio="none" aria-hidden="true">
          <path class="snake-track" d="M 30 20 C 55 140 5 200 30 320 C 55 440 5 500 30 620" />
          <path class="snake-draw" pathLength="1" d="M 30 20 C 55 140 5 200 30 320 C 55 440 5 500 30 620" />
        </svg>
        <div class="snake-mobile-list">
          <div class="snake-mobile-item" data-snake-threshold="0">
            <span class="snake-dot"></span>
            <div class="snake-year">2014</div>
            <p class="snake-text"><strong>Die Anfänge.</strong> 2014 mit einem kleinen, geliehenen Imbissanhänger gestartet — die Qualität hat euch trotzdem überzeugt.</p>
          </div>
          <div class="snake-mobile-item" data-snake-threshold="0.33">
            <span class="snake-dot"></span>
            <div class="snake-year">2015</div>
            <p class="snake-text"><strong>Neuer Wagen.</strong> Größer, ganz auf uns zugeschnitten — dazu neue Kreationen rund um Wurst und Pommes. Qualität und Frische blieben, wie sie waren.</p>
          </div>
          <div class="snake-mobile-item" data-snake-threshold="0.66">
            <span class="snake-dot"></span>
            <div class="snake-year">2020</div>
            <p class="snake-text"><strong>Der Bus kam dazu.</strong> Der Foodtruck 2.0 — ein umgebauter Linienbus, extra für uns gebaut — bringt seitdem einen Indoorbereich für die Schietwetter-Tage am Strand.</p>
          </div>
          <div class="snake-mobile-item" data-snake-threshold="1">
            <span class="snake-dot"></span>
            <div class="snake-year">2024</div>
            <p class="snake-text"><strong>Digital angekommen.</strong> Bestellen und bezahlen per Handy, zwei Self-Order-Terminals, Abholnummern auf Bildschirmen und Bezahlen per QR-Code.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="uu-video reveal" style="transition-delay:0.25s">
      <div class="video-label">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="#FF0000"><path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.5A3 3 0 00.5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 002.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 002.1-2.1C24 15.9 24 12 24 12s0-3.9-.5-5.8z"/><polygon fill="white" points="9.75,15.5 15.5,12 9.75,8.5"/></svg>
        Schau mal rein — unser Truck in Aktion
      </div>

      <div
        class="yt-facade video-wrapper"
        data-videoid={YT_ID}
        role="button"
        tabindex="0"
        aria-label="Video abspielen: Beach and Food – Foodtruck am Sütel-Strand"
      >
        <img
          src={ytThumbnail}
          alt="Beach and Food – Foodtruck am Sütel-Strand – Video abspielen"
          loading="lazy"
          width="1280"
          height="720"
          class="yt-thumbnail"
        />
        <span class="yt-play-btn" aria-hidden="true">
          <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
            <path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="#f00"/>
            <path d="M45 24 27 14v20" fill="#fff"/>
          </svg>
        </span>
        <div class="yt-consent-note">
          Mit Klick auf Play wird eine Verbindung zu YouTube hergestellt.
          <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Datenschutz</a>
        </div>
      </div>
    </div>

    <div class="uu-badges reveal" style="transition-delay:0.35s">
      <div class="badge-card">
        <div class="bc-number bc-heat" data-countup="167" data-suffix="°C">167°C</div>
        <div class="bc-label">Frittiertemperatur</div>
        <div class="bc-sub">Alles andere ist Wissenschaft.</div>
      </div>
      <div class="badge-card">
        <div class="bc-icon">🚌</div>
        <div class="bc-label">Indoor Sitzbereich</div>
        <div class="bc-sub">Umgebauter Linienbus</div>
      </div>
      <div class="badge-card">
        <div class="bc-icon">📱</div>
        <div class="bc-label">Digital Bestellen</div>
        <div class="bc-sub">Self-Order & Online seit 2024</div>
      </div>
      <div class="badge-card">
        <div class="bc-number">Seit<br/>2014</div>
        <div class="bc-sub">am Sütel-Strand</div>
      </div>
    </div>

  </div>
  </div>
</section>

<style>
.ueber-uns {
  padding: 9rem 0;
  background: transparent;
  color: var(--foam);
  position: relative;
  z-index: 1;
}
.ueber-uns .uu-card {
  background-color: var(--ocean-deep);
  /* Schiefer-Textur wie im Footer -- gleicher dunkler Schleier, damit beide
     dunklen Sektionen dieselbe Material-Sprache teilen. clip-path allein
     schneidet die Textur automatisch auf die diagonale Kartenform zu
     (koordinaten liegen ohnehin innerhalb der Box, kein overflow nötig). */
  background-image:
    linear-gradient(rgba(13,34,51,0.8), rgba(13,34,51,0.8)),
    var(--slate-texture);
  background-repeat: repeat;
  padding: 8rem max(1.5rem, calc((100vw - 1200px) / 2 + 1.5rem));
  position: relative;
  /* KEIN overflow:hidden hier -- würde die .snake-desktop-Sticky-Pin-
     Animation weiter unten kaputt machen (overflow != visible auf einem
     Vorfahren bricht position:sticky, das Element würde sich dann relativ
     zu dieser Box statt zum Viewport "festhalten"). clip-path allein
     übernimmt die komplette visuelle Begrenzung auf die diagonale Form. */
  clip-path: polygon(0 4%, 100% 0%, 100% 96%, 0% 100%);
}
.ueber-uns::before {
  content: '';
  position: absolute;
  top: -200px; left: -200px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(46,110,126,0.3) 0%, transparent 70%);
  pointer-events: none;
}
.uu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rem;
  align-items: center;
  margin-bottom: 6rem;
}
.uu-content .section-label {
  color: var(--sun);
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  margin-bottom: 1rem;
}
.uu-content h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 0;
}

/* ── Schlangen-Timeline ──────────────────────────────────────────────
   Volle Breite, unter .uu-grid. Zwei Markup-Varianten (Desktop-Schlange
   mit SVG-Pfad + absolut positionierten Nodes / Mobile-vertikale Liste),
   nur eine ist per Breakpoint sichtbar. Der Scroll-Fortschritt (0..1)
   wird von initSnakeTimeline() im Script berechnet und treibt sowohl
   stroke-dashoffset der Pfade als auch die .active-Klasse der Nodes. */
.uu-timeline-snake {
  margin: 5rem 0 0.5rem;
  position: relative;
}
.snake-svg, .snake-svg-mobile { display: block; width: 100%; height: 100%; overflow: visible; }
.snake-track { fill: none; stroke: rgba(255,255,255,0.1); stroke-width: 3; stroke-linecap: round; }
.snake-draw {
  fill: none;
  stroke: var(--sun);
  stroke-width: 3;
  stroke-linecap: round;
  stroke-dasharray: 1;
  stroke-dashoffset: 1;
}

/* -- Desktop -- */
/* Hoher Runway: .snake-desktop bleibt darin per JS-Pin (siehe
   initSnakeTimeline) stehen, solange man durch .snake-desktop-pin
   scrollt -- die Zeichnen-Animation bekommt dadurch eine deutlich
   längere, ruhigere Scroll-Strecke statt im alten kurzen Fenster
   durchzurauschen. Höhe als Vielfaches von vh, nicht fix, damit die
   gefühlte Scroll-Geschwindigkeit auf jedem Bildschirm gleich bleibt.

   KEIN position:sticky hier: html/body haben sitework overflow-x:hidden
   (Scrollbar-Verstecken-Trick), was overflow-y computed automatisch auf
   "auto" kippt (CSS-Spec-Regel bei gemischten overflow-x/y-Werten) --
   das macht html/body zum offiziellen Scroll-Container und bricht
   position:sticky für alle Nachfahren, egal wie tief verschachtelt.
   initSnakeTimeline() baut das Pin-Verhalten deshalb per JS nach
   (fixed/absolute je nach Scroll-Position statt sticky). */
.snake-desktop-pin { position: relative; height: 260vh; }
.snake-desktop {
  position: relative;
  height: 700px;
}
@media (prefers-reduced-motion: reduce) {
  .snake-desktop-pin { height: auto; }
}
.snake-desktop .snake-svg { position: absolute; inset: 0; }
.snake-node { position: absolute; width: 0; height: 0; }
.snake-dot {
  position: absolute; left: 0; top: 0;
  width: 20px; height: 20px; border-radius: 50%;
  background: var(--sun);
  border: 3px solid var(--ocean-deep);
  box-shadow: 0 0 0 5px rgba(244,168,32,0.18);
  transform: translate(-50%, -50%) scale(0);
  transition: transform 0.65s cubic-bezier(0.34, 1.9, 0.5, 1);
}
.snake-node.active .snake-dot { transform: translate(-50%, -50%) scale(1); }

/* Einmaliger "Lande"-Blitz bei JEDEM Node beim Aktivieren -- macht den
   Moment, in dem ein Punkt erscheint, spürbarer als nur die Dot-Bounce.
   Läuft über ::before, damit es nicht mit dem dauerhaften Puls-Ring des
   --current-Nodes (::after) kollidiert; retriggert bei jedem aktiv/inaktiv-
   Wechsel, weil das Scrubbing rückwärts/vorwärts erneut durch den
   Schwellenwert läuft. */
.snake-dot::before {
  content: '';
  position: absolute;
  inset: -6px;
  border-radius: 50%;
  border: 2px solid var(--sun);
  opacity: 0;
}
.snake-node.active .snake-dot::before {
  animation: snakeLandFlash 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes snakeLandFlash {
  0%   { transform: scale(0.6); opacity: 0.9; }
  100% { transform: scale(1.9); opacity: 0; }
}

/* Letzter Punkt = "aktuellster" Eintrag: zusätzlich dauerhaft dezenter
   Puls-Ring markiert ihn als Endpunkt/Gegenwart. */
.snake-node--current .snake-dot::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px solid var(--sun);
  opacity: 0;
}
.snake-node--current.active .snake-dot::after {
  animation: snakeCurrentPulse 2.2s ease-out 0.6s infinite;
}
@keyframes snakeCurrentPulse {
  0%   { transform: scale(1); opacity: 0.55; }
  100% { transform: scale(2.1); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .snake-node--current .snake-dot::after,
  .snake-dot::before { animation: none; }
}

.snake-card {
  position: absolute;
  width: 280px;
  opacity: 0;
  transition: opacity 0.5s ease 0.15s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
}
.snake-node.active .snake-card { opacity: 1; }
.snake-node--left .snake-card {
  left: 0; top: 50%;
  transform: translate(0, -50%) translateX(-16px);
  margin-left: 22px;
}
.snake-node--left.active .snake-card { transform: translate(0, -50%) translateX(0); }
.snake-node--right .snake-card {
  right: 0; top: 50%;
  transform: translate(0, -50%) translateX(16px);
  margin-right: 22px;
  text-align: right;
}
.snake-node--right.active .snake-card { transform: translate(0, -50%) translateX(0); }
.snake-year {
  font-family: 'Darwin ALT', 'Darwin ALT Fallback', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--sun);
  margin-bottom: 0.3rem;
}
.snake-text { font-size: 0.95rem; color: rgba(255,255,255,0.75); line-height: 1.65; }
.snake-text strong { color: var(--foam); }

/* -- Mobile -- */
.snake-mobile { display: none; position: relative; }
.snake-svg-mobile { position: absolute; left: 4px; top: 0; width: 32px; height: 100%; }
.snake-mobile-list { display: flex; flex-direction: column; gap: 2.5rem; padding-left: 3.2rem; }
.snake-mobile-item { position: relative; }
.snake-mobile-item .snake-dot {
  left: -3.2rem; top: 0.3rem;
  transform: translate(-50%, 0) scale(0);
}
.snake-mobile-item.active .snake-dot { transform: translate(-50%, 0) scale(1); }
.snake-mobile-item.active .snake-dot::before {
  animation: snakeLandFlash 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.snake-mobile-item .snake-year { margin-bottom: 0.2rem; }
.snake-mobile-item .snake-text {
  opacity: 0;
  transform: translateX(-16px);
  transition: opacity 0.5s ease 0.15s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s;
}
.snake-mobile-item.active .snake-text { opacity: 1; transform: translateX(0); }

@media (max-width: 900px) {
  .snake-desktop-pin { display: none; height: auto; }
  .snake-mobile { display: block; }
  .uu-timeline-snake { margin: 3rem 0 4rem; }
}

@media (prefers-reduced-motion: reduce) {
  .snake-dot, .snake-card, .snake-mobile-item .snake-text { transition: none !important; }
}

.uu-image {
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.carousel {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  height: 480px;
  background: #0d2233;
  box-shadow: 0 20px 60px rgba(0,0,0,0.4);
}
.carousel-track {
  display: flex;
  height: 100%;
  width: 100%;
  position: relative;
  overflow: hidden;
}
.carousel-slide {
  position: absolute;
  inset: 0;
  transform: translateX(100%);
  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
}
.carousel-slide.active {
  transform: translateX(0);
  pointer-events: auto;
}
.carousel-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.carousel-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(13,34,51,0.85) 0%, transparent 100%);
  color: rgba(255,255,255,0.9);
  font-size: 0.85rem;
  padding: 2rem 1.25rem 1rem;
  pointer-events: none;
}
.carousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  background: rgba(13,34,51,0.7);
  border: 1px solid rgba(255,255,255,0.15);
  backdrop-filter: blur(8px);
  color: var(--foam);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s, transform 0.2s, opacity 0.2s;
  opacity: 0.75;
}
.carousel-btn:hover {
  background: rgba(244,168,32,0.85);
  color: var(--ocean-deep);
  opacity: 1;
  transform: translateY(-50%) scale(1.08);
}
.carousel-prev { left: 1rem; }
.carousel-next { right: 1rem; }
.carousel-dots {
  position: absolute;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
